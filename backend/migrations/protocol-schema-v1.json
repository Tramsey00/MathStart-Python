  "constraints": [
    {
      "table_name": "target_active_release",
      "name": "target_active_fence_positive",
      "type": "c",
      "definition": "CHECK ((fence_generation > 0))"
    },
    {
      "table_name": "target_active_release",
      "name": "target_active_gate_fk",
      "type": "f",
      "definition": "FOREIGN KEY (namespace) REFERENCES target_publication_gate(namespace) DEFERRABLE INITIALLY DEFERRED"
    },
    {
      "table_name": "target_active_release",
      "name": "target_active_journal_fk",
      "type": "f",
      "definition": "FOREIGN KEY (operation_id, namespace) REFERENCES target_publication_journal(id, namespace) DEFERRABLE INITIALLY DEFERRED"
    },
    {
      "table_name": "target_active_release",
      "name": "target_active_release_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (namespace)"
    },
    {
      "table_name": "target_identity_cutover",
      "name": "target_checkpoint_unique",
      "type": "u",
      "definition": "UNIQUE (checkpoint_digest)"
    },
    {
      "table_name": "target_identity_cutover",
      "name": "target_cutover_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "target_publication_gate",
      "name": "target_gate_fence_nonnegative",
      "type": "c",
      "definition": "CHECK ((fence_generation >= 0))"
    },
    {
      "table_name": "target_publication_gate",
      "name": "target_gate_pending_fk",
      "type": "f",
      "definition": "FOREIGN KEY (pending_operation_id, namespace) REFERENCES target_publication_journal(id, namespace) DEFERRABLE INITIALLY DEFERRED"
    },
    {
      "table_name": "target_publication_gate",
      "name": "target_gate_pending_tuple",
      "type": "c",
      "definition": "CHECK ((((pending_operation_id IS NULL) AND (owner_id IS NULL) AND (lease_until IS NULL)) OR ((pending_operation_id IS NOT NULL) AND (owner_id IS NOT NULL) AND (lease_until IS NOT NULL) AND (fence_generation > 0))))"
    },
    {
      "table_name": "target_publication_gate",
      "name": "target_publication_gate_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (namespace)"
    },
    {
      "table_name": "target_publication_history",
      "name": "target_history_fence_positive",
      "type": "c",
      "definition": "CHECK ((fence_generation > 0))"
    },
    {
      "table_name": "target_publication_history",
      "name": "target_history_journal_fk",
      "type": "f",
      "definition": "FOREIGN KEY (operation_id) REFERENCES target_publication_journal(id) DEFERRABLE INITIALLY DEFERRED"
    },
    {
      "table_name": "target_publication_history",
      "name": "target_publication_history_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "target_publication_journal",
      "name": "target_journal_commit_phase",
      "type": "c",
      "definition": "CHECK ((((phase)::text <> ALL ((ARRAY['DB_COMMITTED'::character varying, 'ACTIVATING'::character varying, 'ACTIVATED'::character varying, 'COMPLETE'::character varying])::text[])) OR db_committed))"
    },
    {
      "table_name": "target_publication_journal",
      "name": "target_journal_fence_positive",
      "type": "c",
      "definition": "CHECK ((fence_generation > 0))"
    },
    {
      "table_name": "target_publication_journal",
      "name": "target_journal_namespace_unique",
      "type": "u",
      "definition": "UNIQUE (id, namespace)"
    },
    {
      "table_name": "target_publication_journal",
      "name": "target_journal_phase",
      "type": "c",
      "definition": "CHECK (((phase)::text = ANY ((ARRAY['VALIDATED'::character varying, 'STAGED'::character varying, 'DB_COMMITTED'::character varying, 'ACTIVATING'::character varying, 'ACTIVATED'::character varying, 'RECOVERY_REQUIRED'::character varying, 'COMPLETE'::character varying, 'FAILED_PRECOMMIT'::character varying])::text[])))"
    },
    {
      "table_name": "target_publication_journal",
      "name": "target_journal_precommit",
      "type": "c",
      "definition": "CHECK ((((phase)::text <> 'FAILED_PRECOMMIT'::text) OR (NOT db_committed)))"
    },
    {
      "table_name": "target_publication_journal",
      "name": "target_publication_journal_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
