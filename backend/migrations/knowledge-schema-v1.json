  "constraints": [
    {
      "table_name": "content_topic_skill",
      "name": "content_topic_skill_content_page_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (content_page_id) REFERENCES content_contentpage(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "content_topic_skill",
      "name": "content_topic_skill_importance",
      "type": "c",
      "definition": "CHECK (((importance > (0)::numeric) AND (importance < 'Infinity'::numeric)))"
    },
    {
      "table_name": "content_topic_skill",
      "name": "content_topic_skill_pair",
      "type": "u",
      "definition": "UNIQUE (content_page_id, skill_id)"
    },
    {
      "table_name": "content_topic_skill",
      "name": "content_topic_skill_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "content_topic_skill",
      "name": "content_topic_skill_position",
      "type": "c",
      "definition": "CHECK ((\"position\" >= 0))"
    },
    {
      "table_name": "content_topic_skill",
      "name": "content_topic_skill_role",
      "type": "c",
      "definition": "CHECK (((role)::text = ANY ((ARRAY['PRIMARY'::character varying, 'SECONDARY'::character varying])::text[])))"
    },
    {
      "table_name": "content_topic_skill",
      "name": "content_topic_skill_skill_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (skill_id) REFERENCES knowledge_skill(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "content_topic_skill",
      "name": "content_topic_skill_version",
      "type": "c",
      "definition": "CHECK ((length((mapping_version)::text) > 0))"
    },
    {
      "table_name": "knowledge_skill",
      "name": "knowledge_skill_code_key",
      "type": "u",
      "definition": "UNIQUE (code)"
    },
    {
      "table_name": "knowledge_skill",
      "name": "knowledge_skill_grades",
      "type": "c",
      "definition": "CHECK ((((grade_min IS NULL) AND (grade_max IS NULL)) OR ((grade_min IS NOT NULL) AND (grade_max IS NOT NULL) AND (grade_min >= 1) AND (grade_min <= grade_max) AND (grade_max <= 11))))"
    },
    {
      "table_name": "knowledge_skill",
      "name": "knowledge_skill_nonempty",
      "type": "c",
      "definition": "CHECK (((length((code)::text) > 0) AND (length((name)::text) > 0) AND (length((graph_version)::text) > 0)))"
    },
    {
      "table_name": "knowledge_skill",
      "name": "knowledge_skill_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "knowledge_skill_dependency",
      "name": "knowledge_dependency_no_self",
      "type": "c",
      "definition": "CHECK ((prerequisite_id <> dependent_id))"
    },
    {
      "table_name": "knowledge_skill_dependency",
      "name": "knowledge_dependency_pair",
      "type": "u",
      "definition": "UNIQUE (prerequisite_id, dependent_id)"
    },
    {
      "table_name": "knowledge_skill_dependency",
      "name": "knowledge_dependency_weight",
      "type": "c",
      "definition": "CHECK (((weight > (0)::numeric) AND (weight <= (1)::numeric)))"
    },
    {
      "table_name": "knowledge_skill_dependency",
      "name": "knowledge_skill_dependency_dependent_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (dependent_id) REFERENCES knowledge_skill(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "knowledge_skill_dependency",
      "name": "knowledge_skill_dependency_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "knowledge_skill_dependency",
      "name": "knowledge_skill_dependency_prerequisite_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (prerequisite_id) REFERENCES knowledge_skill(id) ON DELETE RESTRICT"
    }
  ],
