  "constraints": [
    {
      "table_name": "progress_attempt_binding",
      "name": "progress_attempt_binding_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (attempt_id)"
    },
    {
      "table_name": "progress_attempt_binding",
      "name": "progress_attempt_binding_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth_user(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "progress_completion",
      "name": "progress_completion_attempt_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (attempt_id) REFERENCES progress_attempt_binding(attempt_id) ON DELETE RESTRICT"
    },
    {
      "table_name": "progress_completion",
      "name": "progress_completion_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (completion_id)"
    },
    {
      "table_name": "progress_completion",
      "name": "progress_completion_policy",
      "type": "c",
      "definition": "CHECK (((policy_version)::text = 'progress-v1.1'::text))"
    },
    {
      "table_name": "progress_completion",
      "name": "progress_completion_skill_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (skill_id) REFERENCES knowledge_skill(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "progress_completion",
      "name": "progress_completion_source",
      "type": "u",
      "definition": "UNIQUE (attempt_id, skill_id)"
    },
    {
      "table_name": "progress_completion",
      "name": "progress_completion_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth_user(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "progress_event",
      "name": "progress_event_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (event_id)"
    },
    {
      "table_name": "progress_event",
      "name": "progress_event_policy",
      "type": "c",
      "definition": "CHECK (((policy_version)::text = 'progress-v1'::text))"
    },
    {
      "table_name": "progress_event",
      "name": "progress_event_skill_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (skill_id) REFERENCES knowledge_skill(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "progress_event",
      "name": "progress_event_source",
      "type": "u",
      "definition": "UNIQUE (attempt_id, skill_id, event_kind, evidence_ref)"
    },
    {
      "table_name": "progress_event",
      "name": "progress_event_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth_user(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "progress_self_report_receipt",
      "name": "progress_self_report_receipt_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (user_id, key_digest)"
    },
    {
      "table_name": "progress_self_report_receipt",
      "name": "progress_self_report_receipt_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth_user(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "progress_user_skill_state",
      "name": "progress_state_bounds",
      "type": "c",
      "definition": "CHECK ((((mastery >= (0)::numeric) AND (mastery <= (100)::numeric)) AND ((confidence >= (0)::numeric) AND (confidence <= (100)::numeric)) AND (evidence_count >= 0)))"
    },
    {
      "table_name": "progress_user_skill_state",
      "name": "progress_state_policy",
      "type": "c",
      "definition": "CHECK (((reducer_version)::text = 'progress-v1.1'::text))"
    },
    {
      "table_name": "progress_user_skill_state",
      "name": "progress_state_status",
      "type": "c",
      "definition": "CHECK (((status)::text = ANY ((ARRAY['NOT_STARTED'::character varying, 'LEARNING'::character varying, 'WEAK'::character varying, 'MASTERED'::character varying])::text[])))"
    },
    {
      "table_name": "progress_user_skill_state",
      "name": "progress_user_skill_state_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (user_id, skill_id)"
    },
    {
      "table_name": "progress_user_skill_state",
      "name": "progress_user_skill_state_skill_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (skill_id) REFERENCES knowledge_skill(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "progress_user_skill_state",
      "name": "progress_user_skill_state_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth_user(id) ON DELETE RESTRICT"
    }
