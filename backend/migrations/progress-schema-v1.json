  "schema_objects": [
    {
      "kind": "routine",
      "name": "progress_guard_history",
      "definition": "CREATE OR REPLACE FUNCTION public.progress_guard_history()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog', 'public'\nAS $function$\n        BEGIN\n            RAISE EXCEPTION 'Progress source history is immutable' USING ERRCODE = '23514';\n        END;\n        $function$\n",
      "enabled": null
    },
    {
      "kind": "trigger",
      "name": "progress_attempt_binding_history_guard",
      "definition": "CREATE TRIGGER progress_attempt_binding_history_guard BEFORE DELETE OR UPDATE ON public.progress_attempt_binding FOR EACH ROW EXECUTE FUNCTION progress_guard_history()",
      "enabled": "O"
    },
    {
      "kind": "trigger",
      "name": "progress_attempt_binding_truncate_guard",
      "definition": "CREATE TRIGGER progress_attempt_binding_truncate_guard BEFORE TRUNCATE ON public.progress_attempt_binding FOR EACH STATEMENT EXECUTE FUNCTION progress_guard_history()",
      "enabled": "O"
    },
    {
      "kind": "trigger",
