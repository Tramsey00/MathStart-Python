# Alternative host CLI environment, NOT auto-loaded by dev or Python.
# Primary dev.cmd/Compose generates its own private files in ignored var/compose.
# Alternative team_local.py also generates private JSON; neither copies this file.
# Replace placeholders; never commit the resulting .env or load it into logs.
MATHSTART_DB_BACKEND=postgresql
MATHSTART_DATABASE_URL=postgresql+psycopg://local_runtime:replace-with-local-password@127.0.0.1:55449/mathstart_dev
MATHSTART_HTTP_SIGNING_KEY=replace-with-at-least-32-random-characters
MATHSTART_SCHEMA_SIGNING_KEY=replace-with-a-different-random-key
MATHSTART_PUBLIC_ORIGIN=http://127.0.0.1:8131
MATHSTART_RELEASE_ROOT=var/local/team/serving/releases
MATHSTART_PUBLIC_ARTIFACT_ROOT=var/local/team/serving/frontend
MATHSTART_PUBLIC_ARTIFACT_DIGESTS={}
# Explicit schema/operator/prepare/build/plan/publish: deploy/RELEASE.md.
# API startup does not create a schema or publish content.
