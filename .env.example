DJANGO_SECRET_KEY=replace-with-a-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_HSTS_SECONDS=0

# Main dev/test database; no automatic SQLite fallback.
DJANGO_DB_BACKEND=postgresql
DJANGO_DB_NAME=mathstart
DJANGO_DB_USER=mathstart
DJANGO_DB_PASSWORD=replace-with-a-local-only-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_CONNECT_TIMEOUT=5
DJANGO_DB_TEST_NAME=test_mathstart
# Optional absolute runtime directory (media/staticfiles/reports/backups).
# DJANGO_RUNTIME_ROOT=C:/Projects/MathStart-Python/var/dev-runtime
# Explicit legacy mode: DJANGO_DB_BACKEND=sqlite and DJANGO_DB_PATH=...
