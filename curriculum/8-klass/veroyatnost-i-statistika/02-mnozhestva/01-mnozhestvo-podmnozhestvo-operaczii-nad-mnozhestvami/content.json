                  "tag": "h3",
                  "attrs": {
                    "class": "ms-card-title"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "Не принадлежит множеству"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": "\n        "
                },
                {
                  "kind": "paragraph",
                  "tag": "p",
                  "attrs": {
                    "class": "ms-card-text"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "Запись "
                    },
                    {
