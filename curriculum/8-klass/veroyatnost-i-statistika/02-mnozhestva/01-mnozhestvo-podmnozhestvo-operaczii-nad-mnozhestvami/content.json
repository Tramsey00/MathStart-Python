    {
      "id": "lesson-section-3",
      "title": "Подмножество",
      "nodes": [
        {
          "kind": "text",
          "text": "\n    "
        },
        {
          "kind": "text",
          "text": "\n    "
        },
        {
          "kind": "paragraph",
          "tag": "p",
          "attrs": {
            "class": "ms-text"
          },
          "children": [
            {
              "kind": "text",
              "text": "Множество B называют "
            },
            {
              "kind": "element",
              "tag": "strong",
              "attrs": {},
              "children": [
                {
                  "kind": "text",
                  "text": "подмножеством"
                }
              ]
            },
            {
              "kind": "text",
              "text": " множества A, если каждый элемент B принадлежит A."
            }
          ]
        },
        {
          "kind": "text",
          "text": "\n    "
        },
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-math-box"
          },
          "children": [
            {
              "kind": "text",
              "text": "\n      "
            },
            {
              "kind": "element",
              "tag": "div",
              "attrs": {},
              "children": [
                {
                  "kind": "element",
                  "tag": "strong",
                  "attrs": {},
                  "children": [
                    {
                      "kind": "text",
                      "text": "B ⊆ A"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " — множество B является подмножеством множества A."
                }
              ]
            },
            {
              "kind": "text",
              "text": "\n    "
            }
          ]
        },
        {
          "kind": "text",
          "text": "\n    "
        },
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-example"
          },
          "children": [
            {
              "kind": "element",
              "tag": "span",
              "attrs": {
                "class": "ms-example-title"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "Пример"
                }
              ]
            },
            {
              "kind": "text",
              "text": "Пусть A = {1, 2, 3, 4, 5}, B = {2, 4}. Оба элемента B входят в A, поэтому B ⊆ A."
            }
          ]
        },
        {
          "kind": "text",
          "text": "\n    "
        },
        {
          "kind": "element",
          "tag": "div",
          "attrs": {
            "class": "ms-card-grid"
          },
          "children": [
            {
              "kind": "text",
              "text": "\n      "
            },
            {
              "kind": "element",
              "tag": "div",
              "attrs": {
                "class": "ms-card"
              },
              "children": [
                {
                  "kind": "element",
                  "tag": "h3",
                  "attrs": {
                    "class": "ms-card-title"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "Само множество"
                    }
                  ]
                },
                {
                  "kind": "paragraph",
                  "tag": "p",
                  "attrs": {
                    "class": "ms-card-text"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "Любое множество является подмножеством самого себя: A ⊆ A."
                    }
                  ]
                }
              ]
            },
            {
              "kind": "text",
              "text": "\n      "
            },
            {
              "kind": "element",
              "tag": "div",
              "attrs": {
                "class": "ms-card"
              },
              "children": [
                {
                  "kind": "element",
                  "tag": "h3",
                  "attrs": {
                    "class": "ms-card-title"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "Пустое множество"
                    }
                  ]
                },
                {
                  "kind": "paragraph",
                  "tag": "p",
                  "attrs": {
                    "class": "ms-card-text"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "Пустое множество считают подмножеством любого множества: ∅ ⊆ A."
                    }
                  ]
                }
              ]
            },
            {
              "kind": "text",
              "text": "\n    "
            }
          ]
        },
        {
          "kind": "text",
          "text": "\n    "
        },
        {
          "kind": "note",
          "tag": "div",
          "attrs": {
            "class": "ms-rule-box"
          },
          "children": [
            {
              "kind": "element",
              "tag": "strong",
              "attrs": {},
              "children": [
                {
                  "kind": "text",
                  "text": "Равные множества"
                }
              ]
            },
            {
              "kind": "text",
              "text": " состоят из одних и тех же элементов. Иначе говоря, A = B тогда и только тогда, когда A ⊆ B и B ⊆ A."
            }
          ]
        },
        {
          "kind": "text",
          "text": "\n  "
        }
      ]
    },
