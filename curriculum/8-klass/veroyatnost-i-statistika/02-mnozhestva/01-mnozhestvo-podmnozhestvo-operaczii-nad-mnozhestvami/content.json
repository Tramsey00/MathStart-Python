                      "tag": "strong",
                      "attrs": {},
                      "children": [
                        {
                          "kind": "text",
                          "text": "5 ∉ A"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " означает, что числа 5 среди элементов A нет."
