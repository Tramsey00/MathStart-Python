                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "kind": "paragraph",
          "tag": "p",
          "attrs": {
            "class": "ms-text"
          },
          "children": [
            {
              "kind": "text",
              "text": "Почему обязательно возникает период? При делении на n возможны лишь остатки 0, 1, …, n − 1. Нулевой остаток завершает деление, а повтор ненулевого остатка запускает повтор тех же цифр."
            }
          ]
        },
        {
          "kind": "note",
          "tag": "div",
          "attrs": {
            "class": "ms-note"
          },
          "children": [
            {
              "kind": "text",
              "text": "Перед проверкой знаменателя сократите дробь: 6/15 = 2/5 = 0,4, хотя исходный знаменатель делится на 3."
            }
          ]
        }
      ]
    },
    {
      "id": "part-3",
      "title": "Из периодической дроби в обыкновенную",
      "nodes": [
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-example"
          },
          "children": [
            {
              "kind": "element",
              "tag": "span",
              "attrs": {
                "class": "ms-example-title"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "Пример 2. Чистый период"
                }
              ]
            },
            {
              "kind": "example",
              "tag": "div",
              "attrs": {
                "class": "ms-math-box"
              },
              "children": [
                {
                  "kind": "element",
                  "tag": "div",
                  "attrs": {
                    "class": "ms-math-row"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "x = 0,(27); 100x = 27,(27);"
                    }
                  ]
                },
                {
                  "kind": "element",
                  "tag": "div",
                  "attrs": {
                    "class": "ms-math-row"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "100x − x = 27; 99x = 27;"
                    }
                  ]
                },
                {
                  "kind": "element",
                  "tag": "div",
                  "attrs": {
                    "class": "ms-math-row"
                  },
                  "children": [
                    {
                      "kind": "element",
                      "tag": "strong",
                      "attrs": {},
                      "children": [
                        {
                          "kind": "text",
                          "text": "x = 27/99 = 3/11."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "kind": "text",
              "text": "Умножили на 100, поскольку в периоде две цифры. Бесконечные одинаковые хвосты при вычитании исчезают."
            }
          ]
        },
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-example"
          },
          "children": [
            {
              "kind": "element",
              "tag": "span",
              "attrs": {
                "class": "ms-example-title"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "Пример 3. Есть цифра до периода"
                }
              ]
            },
            {
              "kind": "example",
              "tag": "div",
              "attrs": {
                "class": "ms-math-box"
              },
              "children": [
                {
                  "kind": "element",
                  "tag": "div",
                  "attrs": {
                    "class": "ms-math-row"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "x = 0,2(7); 10x = 2,(7); 100x = 27,(7);"
                    }
                  ]
                },
                {
                  "kind": "element",
                  "tag": "div",
                  "attrs": {
                    "class": "ms-math-row"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "100x − 10x = 25; 90x = 25;"
                    }
                  ]
                },
                {
                  "kind": "element",
                  "tag": "div",
                  "attrs": {
                    "class": "ms-math-row"
                  },
                  "children": [
                    {
                      "kind": "element",
                      "tag": "strong",
                      "attrs": {},
                      "children": [
                        {
                          "kind": "text",
                          "text": "x = 5/18."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "kind": "text",
              "text": "Обе записи сдвинули так, чтобы повторяющиеся хвосты начинались сразу после запятой."
            }
          ]
        },
        {
          "kind": "note",
          "tag": "div",
          "attrs": {
            "class": "ms-note"
          },
          "children": [
            {
              "kind": "text",
              "text": "Равенство 0,(9) = 1 — точное. Если x = 0,(9), то 10x − x = 9, откуда x = 1. Число может иметь две десятичные записи."
            }
          ]
        }
      ]
    },
    {
      "id": "part-4",
      "title": "Действия с дробями",
      "nodes": [
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-math-box"
          },
          "children": [
            {
              "kind": "element",
              "tag": "div",
              "attrs": {
                "class": "ms-math-row"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "a/b + c/d = (ad + bc)/(bd);"
                }
              ]
            },
            {
              "kind": "element",
              "tag": "div",
              "attrs": {
                "class": "ms-math-row"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "a/b · c/d = ac/(bd);"
                }
              ]
            },
            {
              "kind": "element",
              "tag": "div",
              "attrs": {
                "class": "ms-math-row"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "(a/b) : (c/d) = ad/(bc), если c ≠ 0."
                }
              ]
            },
            {
              "kind": "element",
              "tag": "div",
              "attrs": {
                "class": "ms-math-row"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "Во всех формулах b ≠ 0 и d ≠ 0."
                }
              ]
            }
          ]
        },
        {
          "kind": "paragraph",
          "tag": "p",
          "attrs": {
            "class": "ms-text"
          },
          "children": [
            {
              "kind": "text",
              "text": "При сложении удобно выбирать наименьший общий знаменатель. При умножении можно сократить множители числителя и знаменателя до вычислений. Деление заменяют умножением на обратную дробь."
            }
          ]
        },
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-example"
          },
          "children": [
            {
              "kind": "element",
              "tag": "span",
              "attrs": {
                "class": "ms-example-title"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "Пример 4. Несколько действий"
                }
              ]
            },
            {
              "kind": "example",
              "tag": "div",
              "attrs": {
                "class": "ms-math-box"
              },
              "children": [
                {
                  "kind": "element",
                  "tag": "div",
                  "attrs": {
                    "class": "ms-math-row"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "(5/6 − 3/4) : (−1/8)"
                    }
                  ]
                },
                {
                  "kind": "element",
                  "tag": "div",
                  "attrs": {
                    "class": "ms-math-row"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "= (10/12 − 9/12) · (−8)"
                    }
                  ]
                },
                {
                  "kind": "element",
                  "tag": "div",
                  "attrs": {
                    "class": "ms-math-row"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "text": "= (1/12) · (−8) = "
                    },
                    {
                      "kind": "element",
                      "tag": "strong",
                      "attrs": {},
                      "children": [
                        {
                          "kind": "text",
                          "text": "−2/3."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "part-5",
      "title": "Сравнение и середина отрезка",
      "nodes": [
        {
          "kind": "paragraph",
          "tag": "p",
          "attrs": {
            "class": "ms-text"
          },
          "children": [
            {
              "kind": "text",
              "text": "Для дробей с положительными знаменателями сравнивают перекрёстные произведения. Например, 5/8 < 7/11, поскольку 55 < 56. Среди отрицательных чисел больше то, у которого меньше модуль: −5/8 > −7/11."
            }
          ]
        },
        {
          "kind": "note",
          "tag": "div",
          "attrs": {
            "class": "ms-rule-box"
          },
          "children": [
            {
              "kind": "text",
              "text": "Число, равноудалённое от различных a и b на числовой прямой, равно (a + b)/2. Если a < b, эта середина строго между ними."
            }
          ]
        },
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-example"
          },
          "children": [
            {
              "kind": "element",
              "tag": "span",
              "attrs": {
                "class": "ms-example-title"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "Пример 5. Найти середину"
                }
              ]
            },
            {
              "kind": "text",
              "text": "Для a = −2/3 и b = 5/6 получаем (−2/3 + 5/6)/2 = (1/6)/2 = "
            },
            {
              "kind": "element",
              "tag": "strong",
              "attrs": {},
              "children": [
                {
                  "kind": "text",
                  "text": "1/12"
                }
              ]
            },
            {
              "kind": "text",
              "text": ". Расстояния до концов равны 3/4."
            }
          ]
        },
        {
          "kind": "paragraph",
          "tag": "p",
          "attrs": {
            "class": "ms-text"
          },
          "children": [
            {
              "kind": "text",
              "text": "Между любыми двумя различными рациональными числами есть рациональное число — их середина. Повторяя этот приём, получаем бесконечно много рациональных чисел в любом непустом интервале."
            }
          ]
        }
      ]
    },
    {
      "id": "part-6",
      "title": "Дроби и целые показатели степени",
      "nodes": [
        {
          "kind": "note",
          "tag": "div",
          "attrs": {
            "class": "ms-rule-box"
          },
          "children": [
            {
              "kind": "text",
              "text": "При a ≠ 0: a⁰ = 1 и a⁻ⁿ = 1/aⁿ, где n ∈ ℕ. Отрицательный показатель означает переход к обратному числу, а не отрицательный результат."
            }
          ]
        },
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-example"
          },
          "children": [
            {
              "kind": "element",
              "tag": "span",
              "attrs": {
                "class": "ms-example-title"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "Пример 6. Знак и обратная дробь"
                }
              ]
            },
            {
              "kind": "text",
              "text": "(−2/3)⁻² = (−3/2)² = "
            },
            {
              "kind": "element",
              "tag": "strong",
              "attrs": {},
              "children": [
                {
                  "kind": "text",
                  "text": "9/4"
                }
              ]
            },
            {
              "kind": "text",
              "text": ". Чётная степень отрицательного основания положительна. При нечётном показателе знак остаётся отрицательным."
            }
          ]
        },
        {
          "kind": "note",
          "tag": "div",
          "attrs": {
            "class": "ms-note"
          },
          "children": [
            {
              "kind": "text",
              "text": "−2² = −4, но (−2)² = 4. В первой записи степень относится только к 2, во второй — ко всему числу −2. Нуль нельзя возводить в нулевую или отрицательную степень в используемых школьных правилах."
            }
          ]
        }
      ]
    },
    {
      "id": "part-7",
      "title": "Точные вычисления с периодом",
      "nodes": [
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-example"
          },
          "children": [
            {
              "kind": "element",
              "tag": "span",
              "attrs": {
                "class": "ms-example-title"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "Пример 7. Корень из периодической дроби"
                }
              ]
            },
            {
              "kind": "text",
              "text": "Вычислим √(0,(4)). Сначала 0,(4) = 4/9, затем √(4/9) = "
            },
            {
              "kind": "element",
              "tag": "strong",
              "attrs": {},
              "children": [
                {
                  "kind": "text",
                  "text": "2/3"
                }
              ]
            },
            {
              "kind": "text",
              "text": ". Замена на 0,444 даёт только приближение и меняет условие."
            }
          ]
        },
        {
          "kind": "example",
          "tag": "div",
          "attrs": {
            "class": "ms-example"
          },
          "children": [
            {
              "kind": "element",
              "tag": "span",
              "attrs": {
                "class": "ms-example-title"
              },
              "children": [
                {
                  "kind": "text",
                  "text": "Пример 8. Уравнение"
                }
              ]
            },
            {
              "kind": "text",
              "text": "Решим x + 0,1(6) = 0,75. Здесь 0,1(6) = 1/6 и 0,75 = 3/4. Значит, x = 3/4 − 1/6 = "
            },
            {
              "kind": "element",
              "tag": "strong",
              "attrs": {},
              "children": [
                {
                  "kind": "text",
                  "text": "7/12"
                }
              ]
            },
