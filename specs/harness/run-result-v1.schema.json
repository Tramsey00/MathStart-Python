{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathstart.local/specs/harness/run-result-v1.schema.json",
  "title": "MathStart Harness RunResult v1",
  "description": "Persisted result of one MathStart Harness run.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "run_id",
    "parent_run_id",
    "task_id",
    "repository",
    "status",
    "adapter",
    "execution",
    "diff",
    "artifacts",
    "verification",
    "budget",
    "blockers",
    "next_gate"
  ],

  "properties": {
    "schema_version": {
      "const": "harness-result-v1"
    },

    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },

    "parent_run_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },

    "task_id": {
      "type": "string",
      "pattern": "^MS6-[RVI][0-9]{2}$"
    },

    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_sha",
        "head_sha",
        "branch"
      ],
      "properties": {
        "base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "head_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9._/-]+$"
        }
      }
    },

    "status": {
      "enum": [
        "READY_FOR_REVIEW",
        "FAIL",
        "BLOCKED_CONFIGURATION",
        "NEEDS_HUMAN",
        "INTERRUPTED",
        "BUDGET_EXCEEDED"
      ]
    },

    "adapter": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },

    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "turns_used",
        "wall_time_ms"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "turns_used": {
          "type": "integer",
          "minimum": 0
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_ref",
        "final_ref"
      ],
      "properties": {
        "initial_ref": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096
        },
        "final_ref": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },

    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check_result"
          }
        }
      }
    },

    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turns_used",
        "turns_limit",
        "wall_time_ms",
        "wall_time_limit_ms"
      ],
      "properties": {
        "turns_used": {
          "type": "integer",
          "minimum": 0
        },
        "turns_limit": {
          "type": "integer",
          "minimum": 1
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "wall_time_limit_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },

    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },

    "next_gate": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    }
  },

  "$defs": {
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },

    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },

    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "exit_code"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "exit_code": {
          "type": ["integer", "null"]
        }
      }
    },

    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}