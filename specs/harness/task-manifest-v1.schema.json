{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathstart.local/specs/harness/task-manifest-v1.schema.json",
  "title": "MathStart Harness TaskManifest v1",
  "description": "Contract for a versioned MathStart Harness task before execution.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "task_id",
    "issue_ref",
    "owner",
    "base_sha",
    "branch",
    "workflow",
    "profile",
    "accepted_spec_refs",
    "plan_ref",
    "writable_paths",
    "protected_paths",
    "required_checks",
    "expected_outputs",
    "limits",
    "human_gates"
  ],

  "properties": {
    "schema_version": {
      "const": "harness-task-v1"
    },

    "task_id": {
      "type": "string",
      "pattern": "^MS6-[RVI][0-9]{2}$"
    },

    "issue_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },

    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },

    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },

    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },

    "workflow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },

    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },

    "accepted_spec_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/spec_ref"
      }
    },

    "plan_ref": {
      "$ref": "#/$defs/spec_ref"
    },

    "writable_paths": {
      "$ref": "#/$defs/path_list"
    },

    "protected_paths": {
      "$ref": "#/$defs/path_list"
    },

    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },

    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },

    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_turns",
        "wall_time_seconds"
      ],
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },

        "wall_time_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },

    "human_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },

  "$defs": {
    "spec_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repository_path"
        },

        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },

    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*\\\\)[^\\u0000]+$"
    },

    "path_pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*\\\\)[^\\u0000]+$"
    },

    "path_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path_pattern"
      }
    }
  }
}