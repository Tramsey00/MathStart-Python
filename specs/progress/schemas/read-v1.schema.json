{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathstart:progress:read:n012-v1",
  "$comment": "Additive retained R03 identities; frozen HTTP DTOs unchanged. Native IDs remain UUID.",
  "$defs": {
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        }
      },
      "required": [
        "request_id"
      ]
    },
    "Pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "next_cursor",
        "page_size",
        "has_more"
      ]
    },
    "ProgressEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_code": {
          "type": "string",
          "minLength": 1
        },
        "event_kind": {
          "type": "string",
          "enum": [
            "SELF_REPORTED_KNOWN",
            "CORRECT_FIRST_TRY",
            "CORRECT_AFTER_HINT",
            "WRONG_ATTEMPT",
            "MISCONCEPTION_DETECTED",
            "ANSWER_REVEALED",
            "DIAGNOSTIC_CORRECT",
            "DIAGNOSTIC_WRONG"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "const": "progress-v1"
        }
      },
      "required": [
        "event_id",
        "skill_code",
        "event_kind",
        "occurred_at",
        "attempt_id",
        "evidence_ref",
        "policy_version"
      ]
    },
    "ProgressEventListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgressEvent"
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "pagination": {
              "$ref": "#/$defs/Pagination"
            }
          },
          "required": [
            "request_id",
            "pagination"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "SelfReportResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted_skill_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "already_reported_skill_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "accepted_skill_codes",
        "already_reported_skill_codes"
      ]
    },
    "SelfReportResultResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/SelfReportResult"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "SkillProgress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_code": {
          "type": "string",
          "minLength": 1
        },
        "mastery": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "NOT_STARTED",
            "LEARNING",
            "WEAK",
            "MASTERED"
          ]
        },
        "last_updated": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reducer_version": {
          "const": "progress-v1.1"
        },
        "self_reported": {
          "type": "boolean"
        }
      },
      "required": [
        "skill_code",
        "mastery",
        "confidence",
        "evidence_count",
        "status",
        "last_updated",
        "reducer_version",
        "self_reported"
      ]
    },
    "SkillProgressListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillProgress"
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "pagination": {
              "$ref": "#/$defs/Pagination"
            }
          },
          "required": [
            "request_id",
            "pagination"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "TopicProgress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": {
          "$ref": "#/$defs/TopicReference"
        },
        "mastery": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "assessed_skill_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_skill_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "topic",
        "mastery",
        "confidence",
        "assessed_skill_count",
        "total_skill_count"
      ]
    },
    "TopicProgressListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicProgress"
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "pagination": {
              "$ref": "#/$defs/Pagination"
            }
          },
          "required": [
            "request_id",
            "pagination"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "TopicReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "slug": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "slug"
      ]
    },
    "SelfReportRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "skill_codes"
      ]
    },
    "ConflictEnvelope": {
      "oneOf": [
        {
          "$ref": "#/$defs/RevisionConflict"
        },
        {
          "$ref": "#/$defs/IdempotencyConflict"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "VERSION_CONFLICT",
                    "STATE_CONFLICT"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "field_errors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "retryable": {
                  "type": "boolean"
                },
                "request_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "code",
                "message",
                "field_errors",
                "retryable",
                "request_id"
              ]
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "RevisionConflict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "const": "REVISION_CONFLICT"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field_errors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "current_revision": {
              "type": "integer",
              "minimum": 1
            },
            "reload_url": {
              "type": "string",
              "pattern": "^/api/v1/attempts/[0-9a-f-]{36}/$"
            }
          },
          "required": [
            "code",
            "message",
            "field_errors",
            "retryable",
            "request_id",
            "current_revision",
            "reload_url"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "IdempotencyConflict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "const": "IDEMPOTENCY_CONFLICT"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field_errors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "code",
            "message",
            "field_errors",
            "retryable",
            "request_id"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "AuthenticationError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "AUTHENTICATION_REQUIRED"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field_errors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "code",
            "message",
            "field_errors",
            "retryable",
            "request_id"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "ForbiddenError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "CSRF_FAILED",
                "FORBIDDEN"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field_errors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "code",
            "message",
            "field_errors",
            "retryable",
            "request_id"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "BadRequestError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "LIMIT_EXCEEDED"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field_errors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "code",
            "message",
            "field_errors",
            "retryable",
            "request_id"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "NotFoundError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "NOT_FOUND"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field_errors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "code",
            "message",
            "field_errors",
            "retryable",
            "request_id"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "RateLimitError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "RATE_LIMITED"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field_errors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "code",
            "message",
            "field_errors",
            "retryable",
            "request_id"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "UnavailableError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "SERVICE_UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field_errors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "code",
            "message",
            "field_errors",
            "retryable",
            "request_id"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "CompletionHistory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completion_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "CORRECT",
            "WRONG",
            "UNSUPPORTED",
            "INDETERMINATE"
          ]
        },
        "independent_correct": {
          "type": "boolean"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "policy_version": {
          "const": "progress-v1.1"
        },
        "skill_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "completion_id",
        "attempt_id",
        "outcome",
        "independent_correct",
        "completed_at",
        "policy_version",
        "skill_code"
      ]
    },
    "CompletionHistoryListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompletionHistory"
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "pagination": {
              "$ref": "#/$defs/Pagination"
            }
          },
          "required": [
            "request_id",
            "pagination"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    }
  }
}
