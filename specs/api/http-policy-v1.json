  "revision": {
    "initial": 1,
    "draft": "full_replace",
    "required_operations": [
      "update_draft",
      "submit_attempt",
      "abandon_attempt"
    ],
    "increments": [
      "update_draft",
      "submit_attempt",
      "abandon_attempt"
    ],
    "stale_status": 409,
    "frozen_states": [
      "SUBMITTED",
      "COMPLETED",
      "REVIEWED",
      "ABANDONED"
    ],
    "correction": "new_attempt_with_previous_attempt_id"
  },
  "lifecycle": {
    "assessed": [
      [
        "STARTED",
        "SUBMITTED"
      ],
      [
        "SUBMITTED",
        "COMPLETED"
      ],
      [
        "STARTED",
        "ABANDONED"
      ]
    ],
    "self_check": [
      [
        "STARTED",
        "REVIEWED"
      ],
      [
        "STARTED",
        "ABANDONED"
      ]
    ],
    "outcomes": [
      "CORRECT",
      "WRONG",
      "UNSUPPORTED",
      "INDETERMINATE"
    ]
  },
  "idempotency": {
    "scope": [
      "owner",
      "operation",
      "key"
    ],
    "digest_fields": [
      "owner",
      "operation",
      "canonical_route",
      "body",
      "expected_revision"
    ],
    "digest_encoding": "SHA-256 of UTF-8 JSON; sorted keys, compact separators, preserve array order, no NaN; no Unicode/math normalization",
    "same_digest": "replay_persisted_status_body_operation",
    "different_digest_status": 409,
    "retention_seconds_min": 604800,
    "permanent_source_uniqueness": true,
    "check_before_revision_state": true
  },
  "exposure": {
    "key": [
      "owner",
      "exercise_version_id"
    ],
    "serialized_actions": [
      "hint",
      "reveal",
      "submit",
      "finalize"
    ],
    "hint_persists": true,
    "reveal_persists": true,
    "help_levels": [
      0,
      1,
      2,
      3
    ],
    "positive_credit_max": 1,
    "eligibility_freeze": "finalize_under_exposure_lock",
    "submit_freezes_snapshot": true,
    "pending_help_invalidates_independence": true,
    "completed_result_not_revoked": true,
    "self_check_positive": false
  },
  "limits": {
    "request_bytes": 65536,
    "steps": 40,
    "expression_chars": 512,
    "tokens": 128,
    "nesting": 16,
    "numeric_digits": 12,
    "abs_power": 10,
    "expression_ms": 250,
    "batch_ms": 2000
  },
  "pagination": {
    "default": 20,
    "maximum": 100,
    "order": [
      "created_at",
      "id"
    ],
    "direction": "ascending",
    "cursor_owner_filter_bound": true
  },
  "security": {
    "mutations_csrf": true,
    "foreign_owner_status": 404,
    "anonymous_status": 401,
    "get_domain_side_effects": false,
    "raw_fields": "untrusted_data",
    "public_health_allowlist": [
      "status",
      "database",
      "configuration",
      "provider"
    ]
  }
