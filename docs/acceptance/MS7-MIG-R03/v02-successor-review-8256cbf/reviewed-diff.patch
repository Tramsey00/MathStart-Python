+      "source_utf8": "\"\"\"Actual localhost HTTP smoke with no installed/imported Django and a new marked DB.\"\"\"\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport socket\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\nimport uuid\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n\nif '--serve' in sys.argv:\n    from backend.infrastructure.http.runtime import application\n    import uvicorn\n    uvicorn.run(application(), host='127.0.0.1', port=int(sys.argv[-1]), access_log=False, log_level='warning')\n    raise SystemExit(0)\n\nassert importlib.util.find_spec('django') is None\nimport sqlalchemy as sa\nfrom sqlalchemy.engine import make_url\nfrom backend.content.releases import ReleaseStore\nfrom backend.infrastructure.database import DatabaseConfig, create_engine\nfrom backend.infrastructure.http.runtime import application\nfrom backend.migrations.upgrade import fresh\nfrom backend.tests.v02.fixtures import seed, release_files, activate_fixture\nroot = Path('var/i02-runtime-' + uuid.uuid4().hex).resolve()\nroot.mkdir(parents=True)\nurl = make_url('postgresql+psycopg://postgres:synthetic-local-only@127.0.0.1:15441/postgres')\nname = 'test_ms7_mig_v01_v02_runtime_' + uuid.uuid4().hex\nadmin = sa.create_engine(url, isolation_level='AUTOCOMMIT', hide_parameters=True)\nquoted = admin.dialect.identifier_preparer.quote(name)\nwith admin.connect() as connection:\n    connection.execute(sa.text('CREATE DATABASE ' + quoted))\n    connection.execute(sa.text(\"COMMENT ON DATABASE \" + quoted + \" IS 'MS7-MIG-V01 disposable synthetic test database'\"))\nengine = create_engine(DatabaseConfig(url.set(database=name)))\nwith engine.begin() as connection:\n    fresh(connection)\nseed(engine)\nstore, descriptor, index, deliveries = release_files(root)\nactivate_fixture(engine, descriptor)\ncontext = store.load(descriptor).renderer_context(deliveries[304], {'q': 'none'})\nassert context['catalogue_full'] == index['catalogue'] and context['catalogue_count'] == 0\nenvironment = {**os.environ, 'MATHSTART_DATABASE_URL': str(url.set(database=name).render_as_string(hide_password=False)),\n    'MATHSTART_HTTP_SIGNING_KEY': 'synthetic-i02-runtime-only', 'MATHSTART_PUBLIC_ORIGIN': 'https://mathstart.example',\n    'MATHSTART_RELEASE_ROOT': str(root), 'PYTHONIOENCODING': 'utf-8', 'PYTHONDONTWRITEBYTECODE': '1'}\nwith socket.socket() as sock:\n    sock.bind(('127.0.0.1', 0))\n    port = sock.getsockname()[1]\nlog = root / 'server.log'\ncases = []\nwith log.open('wb') as output:\n    server = subprocess.Popen([sys.executable, '-B', __file__, '--serve', str(port)], env=environment,\n                              stdout=output, stderr=subprocess.STDOUT)\n    try:\n        for _ in range(100):\n            if server.poll() is not None:\n                raise RuntimeError('Smoke server exited before startup')\n            try:\n                with socket.create_connection(('127.0.0.1', port), timeout=0.1):\n                    break\n            except OSError:\n                time.sleep(0.1)\n        else:\n            raise RuntimeError('Smoke server startup timeout')\n        for path, status in [('/api/v1/grades/', 200), ('/api/v1/content/pages/topic/', 200),\n                             ('/_content/index.json', 200), ('/static/theme.css', 200),\n                             ('/api/v1/staff/pages/', 401), ('/api/v1/nope/', 404),\n                             ('/', 503), ('/karta-sajta/?q=none', 503)]:\n            try:\n                response = urllib.request.urlopen(f'http://127.0.0.1:{port}' + path, timeout=10)\n            except urllib.error.HTTPError as error:\n                response = error\n            with response:\n                raw = response.read()\n                assert response.status == status, (path, response.status)\n                if path == '/_content/index.json':\n                    assert json.loads(raw) == index\n                if path == '/api/v1/content/pages/topic/':\n                    assert json.loads(raw)['data'] == deliveries[302]\n                cases.append({'path': path, 'status': response.status})\n    finally:\n        server.terminate()\n        try:\n            server.wait(timeout=10)\n        except subprocess.TimeoutExpired:\n            server.kill()\n            server.wait(timeout=5)\nassert not any(k == 'django' or k.startswith('django.') for k in sys.modules)\nengine.dispose()\nadmin.dispose()\nprint(json.dumps({'django_installed': False, 'django_imported': False, 'runtime_context_provider': 'PASS',\n    'http_smoke': cases, 'html_renderer': 'ABSENT_AS_DESIGNED: public HTML 503',\n    'database': name, 'disposable': True, 'retained_runtime': str(root),\n    'public_contract_unchanged': True, 'i02_html_no_js': 'NOT_VERIFIED'}))\n",
