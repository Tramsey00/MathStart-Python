+      "source_utf8": "\"\"\"Scoped follow-up verification runner; never stages or refreshes historical evidence.\"\"\"\nfrom datetime import datetime, timezone\nfrom hashlib import sha256\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport time\n\nROOT = Path(__file__).resolve().parents[1]\nE = ROOT / 'docs/acceptance/MS7-MIG-V02/i02-handoff-followup-20261015'\nHEAD = '76d8eac6387a5fde5432a0e8130a881cb6d7ba82'\nALLOWED = {'backend/content/releases.py', 'backend/infrastructure/http/app.py',\n           'backend/tests/v02/test_unit.py', 'backend/tests/v02/test_http.py',\n           'backend/infrastructure/http/README.md'}\nENV = {**os.environ, 'GIT_OPTIONAL_LOCKS': '0', 'PYTHONDONTWRITEBYTECODE': '1', 'PYTHONIOENCODING': 'utf-8',\n       'DJANGO_SECRET_KEY': 'synthetic-i02-followup-only', 'DJANGO_DB_BACKEND': 'sqlite',\n       'DJANGO_RUNTIME_ROOT': str(ROOT / 'var/i02-handoff-contract-runtime')}\nPY = str(ROOT / 'var/ms7-mig-v02-venv/Scripts/python.exe')\n\ndef digest(raw):\n    return sha256(raw).hexdigest()\n\ndef git(*args):\n    return subprocess.check_output(['git', *args], cwd=ROOT, env=ENV)\n\ndef save(path, value):\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n\ndef run(label, argv, extra=None, timeout=900):\n    started = datetime.now(timezone.utc).isoformat()\n    tick = time.monotonic()\n    try:\n        result = subprocess.run(argv, cwd=ROOT, env={**ENV, **(extra or {})}, capture_output=True, timeout=timeout)\n        code, stdout, stderr = result.returncode, result.stdout, result.stderr\n    except subprocess.TimeoutExpired as error:\n        code, stdout, stderr = 124, error.stdout or b'', (error.stderr or b'') + b'\\nVerification runner timeout\\n'\n    E.mkdir(parents=True, exist_ok=True)\n    (E / (label + '.stdout.log')).write_bytes(stdout)\n    (E / (label + '.stderr.log')).write_bytes(stderr)\n    text = (stdout + b'\\n' + stderr).decode('utf-8', errors='replace')\n    counts = re.findall(r'Ran (\\d+) tests? in', text)\n    named = [{'name': match[1], 'result': match[2]} for match in re.findall(\n        r'^(test_\\w+) \\(([\\w.]+)\\) \\.\\.\\. (ok|FAIL|ERROR|skipped[^\\r\\n]*)', text, re.MULTILINE)]\n    record = {'label': label, 'started_utc': started, 'elapsed_seconds': round(time.monotonic() - tick, 3),\n              'argv': argv, 'exit_code': code, 'stdout_sha256': digest(stdout), 'stderr_sha256': digest(stderr),\n              'test_count': int(counts[-1]) if counts else None, 'named_tests': named,\n              'tested_implementation_sha': None, 'parent_candidate_sha': HEAD,\n              'result': 'PASS' if code == 0 else 'FAIL'}\n    save(E / (label + '.json'), record)\n    print(json.dumps({k: v for k, v in record.items() if k != 'named_tests'}), flush=True)\n    if code:\n        print(text[-6000:], flush=True)\n    return code\n\ndef initial():\n    assert git('rev-parse', 'HEAD').decode().strip() == HEAD\n    assert git('branch', '--show-current').decode().strip() == 'ms7-mig-v02-content'\n    assert not git('diff', '--cached', '--name-only')\n    protected = {}\n    for raw in git('ls-files', '-z').split(b'\\0'):\n        if raw:\n            p = raw.decode()\n            if p not in ALLOWED:\n                protected[p] = digest((ROOT / p).read_bytes())\n    idx = Path(git('rev-parse', '--git-path', 'index').decode().strip())\n    baseline = {p: {'blob_oid': git('rev-parse', HEAD + ':' + p).decode().strip(),\n                    'blob_sha256': digest(git('show', HEAD + ':' + p))} for p in sorted(ALLOWED)}\n    save(E / 'source-baseline.json', {'initial_head': HEAD,\n        'initial_tree_oid': git('rev-parse', 'HEAD^{tree}').decode().strip(),\n        'initial_branch': 'ms7-mig-v02-content', 'initial_status': 'Clean working tree/index verified before edits',\n        'raw_index_sha256': digest(idx.read_bytes()), 'protected_working_hashes': protected, 'allowed_baseline': baseline,\n        'authority': 'User supplied Implement Approved I02 Consumer Handoff Fixes, relaying Ruslan/Ilya agreement; no commit/push approval'})\n    print(json.dumps({'protected_files': len(protected), 'baseline_head': HEAD}))\n\nif __name__ == '__main__':\n    mode = sys.argv[1]\n    if mode == 'initial':\n        initial()\n    elif mode == 'red':\n        sys.exit(run('before-fix-home', [PY, '-B', '-m', 'unittest',\n            'backend.tests.v02.test_unit.I02HandoffUnitTests.test_home_requires_slug_alias_even_with_valid_manifest_digest',\n            'backend.tests.v02.test_http.SQLiteHTTPTests.test_i02_home_missing_alias_fails_closed_without_renderer_or_redirect', '-v']))\n    elif mode == 'unit-http':\n        sys.exit(run('v02-unit-http', [PY, '-B', '-m', 'unittest',\n            'backend.tests.v02.test_unit', 'backend.tests.v02.test_http', '-v']))\n    elif mode == 'v02-pg':\n        sys.exit(run('v02-complete', [PY, '-B', '-m', 'unittest', 'backend.tests.v02.test_unit',\n            'backend.tests.v02.test_http', 'backend.tests.v02.test_postgres', 'backend.tests.v02.test_asset_regressions', '-v'],\n            {'MATHSTART_V02_TEST_ADMIN_URL': 'postgresql+psycopg://postgres:synthetic-local-only@127.0.0.1:15441/postgres'}))\n    elif mode == 'r02':\n        sys.exit(run('r02-contracts', [PY, '-B', '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_migration_r02_*.py', '-v']))\n    elif mode == 'baseline':\n        sys.exit(run('baseline-driver', [PY, '-B', '-m', 'backend.tests.v02.baseline'],\n            {'MATHSTART_V02_TEST_ADMIN_URL': 'postgresql+psycopg://postgres:synthetic-local-only@127.0.0.1:15441/postgres'}))\n    elif mode == 'command':\n        sys.exit(run(sys.argv[2], sys.argv[3:]))\n"
