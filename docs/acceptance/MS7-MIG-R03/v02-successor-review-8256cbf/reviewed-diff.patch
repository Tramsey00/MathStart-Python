+      "source_utf8": "import base64\nfrom hashlib import sha256\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\n\nROOT = Path.cwd()\nE = ROOT / 'docs/acceptance/MS7-MIG-V02/i02-handoff-p2-p3-20261015'\nOLD = ROOT / 'docs/acceptance/MS7-MIG-V02/i02-handoff-followup-20261015'\nAUDIT = Path(r'C:\\Users\\vladimir\\AppData\\Local\\Temp\\ms7-independent-ebuqtjb0')\nassert not E.exists()\nENV = {**os.environ, 'GIT_OPTIONAL_LOCKS': '0'}\ndef git(*args):\n    return subprocess.check_output(['git', *args], env=ENV)\ndef sha(raw):\n    return sha256(raw).hexdigest()\ndef save(path, data):\n    path.write_bytes((json.dumps(data, ensure_ascii=True, indent=2) + '\\n').encode('utf-8'))\nassert git('rev-parse', 'HEAD').decode().strip() == '76d8eac6387a5fde5432a0e8130a881cb6d7ba82'\nassert git('branch', '--show-current').decode().strip() == 'ms7-mig-v02-content'\nassert not git('diff', '--cached', '--name-only')\nchanged = git('diff', '--name-only').decode().splitlines()\nuntracked = git('ls-files', '--others', '--exclude-standard').decode().splitlines()\nassert len(changed) == 5 and len(untracked) == 27\ninventory = json.loads((AUDIT / 'independent-inventory.json').read_bytes())\nfor path, record in inventory['tracked_changes'].items():\n    assert sha((ROOT / path).read_bytes()) == record['working_sha256']\nold_inventory = json.loads((OLD / 'evidence-inventory.json').read_bytes())\nfor record in old_inventory['files']:\n    assert sha((ROOT / record['path']).read_bytes()) == record['sha256']\nall_paths = sorted(set(git('ls-files').decode().splitlines() + untracked))\nhashes = {path: sha((ROOT / path).read_bytes()) for path in all_paths}\nreport = (AUDIT / 'Independent-Audit-Report.md').read_bytes()\nold_raw = (OLD / 'raw-command-receipts.json').read_bytes()\nold = json.loads(old_raw.decode('utf-8'))\nmisread = json.loads(old_raw.decode('cp1251'))\nanalysis = {}\nfor path, record in old['reproduction_helper_sources'].items():\n    raw = (ROOT / path).read_bytes()\n    text_raw = record['source_utf8'].encode('utf-8')\n    wrong = misread['reproduction_helper_sources'][path]['source_utf8']\n    assert sha(raw) == record['sha256'] == sha(text_raw)\n    analysis[path] = {'declared_sha256': record['sha256'], 'actual_raw_sha256': sha(raw),\n        'actual_utf8_roundtrip_sha256': sha(text_raw), 'raw_size': len(raw),\n        'utf8_bom': raw.startswith(b'\\xef\\xbb\\xbf'), 'cr': raw.count(b'\\r'), 'lf': raw.count(b'\\n'),\n        'crlf': raw.count(b'\\r\\n'), 'raw_valid_utf8': True,\n        'cp1251_misread_then_utf8_sha256': sha(wrong.encode('utf-8')),\n        'cp1251_misread_recovers_raw_when_reencoded_cp1251': wrong.encode('cp1251') == raw,\n        'git_index_entries': git('ls-files', '--stage', '--', path).decode(),\n        'git_ignore_rule': git('check-ignore', '-v', path).decode().strip()}\nE.mkdir()\nsave(E / 'intake.json', {'head': git('rev-parse', 'HEAD').decode().strip(),\n    'branch': 'ms7-mig-v02-content', 'candidate_tree': git('rev-parse', 'HEAD^{tree}').decode().strip(),\n    'index_sha256': sha(Path(git('rev-parse', '--git-path', 'index').decode().strip()).read_bytes()),\n    'modified': changed, 'untracked': untracked, 'snapshot_file_count': len(hashes), 'snapshot_sha256': hashes,\n    'prior_diff_sha256': sha(git('diff', '--binary')), 'prior_diff_base64': base64.b64encode(git('diff', '--binary')).decode(),\n    'helper_source_pins': {p: r['actual_raw_sha256'] for p, r in analysis.items()},\n    'independent_audit_report_path': str(AUDIT / 'Independent-Audit-Report.md'),\n    'independent_audit_report_sha256': sha(report), 'independent_audit_report_base64': base64.b64encode(report).decode(),\n    'independent_inventory_sha256': sha((AUDIT / 'independent-inventory.json').read_bytes()),\n    'original_helper_record_sha256': sha(old_raw),\n    'authority': 'User requested scoped P2/P3 remediation; no commit/push/merge permission'})\nsave(E / 'p3-byte-analysis.json', {'helper_sources': analysis,\n    'result': 'Original source and UTF-8 JSON bytes are correct. Reported mismatches reproduced exactly by decoding that same JSON as CP1251.',\n    'historical_writer': 'i02_handoff_finalize.py hashes read_bytes and stores raw.decode(); bytes.decode defaults to UTF-8. JSON metadata is UTF-8. No original bytes were corrected.',\n    'previous_guard_gap': 'seal verified command-output base64 hashes but never independently round-tripped helper source_utf8.',\n    'new_hardening': 'Explicit UTF-8, exact raw source base64 with its own digest, text digest, intake source pins and independent physical-file rereads; no old record/expected hash overwrite.'})\nprint(json.dumps({'snapshot_files': len(hashes), 'modified': len(changed), 'untracked': len(untracked),\n                  'audit_sha256': sha(report), 'all_five_original_utf8_sources_match': True}))\n",
