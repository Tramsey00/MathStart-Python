+{
+  "version": "i02-helper-source-bytes-v2",
+  "sources": {
+    "var/i02_handoff_verify.py": {
+      "source_encoding": "utf-8",
+      "raw_sha256": "802c9a17de950cc9160e918a33518ae7d4e49c7434df778b7b4436502588656d",
+      "raw_size": 5635,
