0.0.1', port=15441, database=record['database'])))\nrelease_id = 'i02-loader-' + uuid.uuid4().hex\nroot = ROOT / 'var' / release_id\npages_root = root / release_id / 'pages'\npages_root.mkdir(parents=True)\nsql = []\nsa.event.listen(engine, 'before_cursor_execute', lambda c, cu, statement, p, ctx, m: sql.append(statement))\nwith UnitOfWork(engine) as uow:\n    uow.session.execute(sa.text('SET TRANSACTION READ ONLY'))\n    pages = list(uow.session.scalars(sa.select(ContentPage).where(ContentPage.is_published.is_(True)).order_by(ContentPage.id)))\n    deliveries = {}\n    for page in pages:\n        source = uow.session.scalar(sa.select(LessonPublication.source_path).where(LessonPublication.page_id == page.id))\n        source = 'curriculum/' + source if source else f'site_content/pages/{page.slug}/page.json'\n        path = (ROOT / source).resolve()\n        assert path.is_relative_to(ROOT)\n        if path.is_dir():\n            source += '/lesson.json'\n            path /= 'lesson.json'\n        data = delivery_candidate(uow, page.slug, ReviewedSource(source, sha256(path.read_bytes()).hexdigest(), ()))\n        deliveries[page.id] = data\n        (pages_root / f'{page.id}.json').write_text(json.dumps(data, ensure_ascii=False), encoding='utf-8')\n    index = build_index_candidate(uow, release_id, deliveries)\nraw = json.dumps(index, ensure_ascii=False).encode('utf-8')\n(root / release_id / 'index.json').write_bytes(raw)\ndescriptor = Descriptor(uuid.uuid4(), release_id, sha256(raw).hexdigest(), 1)\nrelease = ReleaseStore(root).load(descriptor)\nassert len(release.pages) == 279 and len(release.index['catalogue']['topics']) == 263\ncontext = release.renderer_context(release.page('karta-sajta'), {'q': '\u041d\u0415\u0421\u0423\u0429\u0415\u0421\u0422\u0412\u0423\u042e\u0429\u0410\u042f \u0422\u0415\u041c\u0410'})\nassert context['catalogue_full'] == index['catalogue']\nassert context['pinned_release'] == {'release_id': release_id, 'manifest_digest': descriptor.manifest