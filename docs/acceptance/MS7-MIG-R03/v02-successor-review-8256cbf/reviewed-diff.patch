+      "source_utf8": "\"\"\"New remediation receipts; the previous audit and all prior27 records stay unchanged.\"\"\"\nimport base64\nfrom hashlib import sha256\nimport json\nfrom pathlib import Path\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport i02_handoff_verify as v\nROOT = v.ROOT\nE = ROOT / 'docs/acceptance/MS7-MIG-V02/i02-handoff-p2-p3-20261015'\nv.E = E\nv.ENV['DJANGO_RUNTIME_ROOT'] = str(ROOT / 'var/i02-p2-p3-contract-runtime')\ndef save(path, data):\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_bytes((json.dumps(data, ensure_ascii=True, indent=2) + '\\n').encode('utf-8'))\nv.save = save\nPY = v.PY\n\ndef sources():\n    pins = json.loads((E / 'intake.json').read_bytes())['helper_source_pins']\n    records = {}\n    for name, expected in pins.items():\n        raw = (ROOT / name).read_bytes()\n        assert sha256(raw).hexdigest() == expected\n        text = raw.decode('utf-8', errors='strict')\n        assert text.encode('utf-8') == raw\n        records[name] = {'source_encoding': 'utf-8', 'raw_sha256': expected, 'raw_size': len(raw),\n            'raw_bytes_base64': base64.b64encode(raw).decode('ascii'), 'source_utf8': text,\n            'source_utf8_sha256': sha256(text.encode('utf-8')).hexdigest(),\n            'byte_profile': {'bom_utf8': raw.startswith(b'\\xef\\xbb\\xbf'), 'crlf': raw.count(b'\\r\\n'),\n                             'cr': raw.count(b'\\r'), 'lf': raw.count(b'\\n')}}\n    save(E / 'helper-sources-v2.json', {'version': 'i02-helper-source-bytes-v2', 'sources': records,\n        'transport_encoding': 'ASCII-escaped JSON, UTF-8/LF; source_utf8 is explicitly re-encoded UTF-8, never locale-decoded',\n        'byte_normalization': 'NONE; original source bytes and separate raw/text digests are preserved',\n        'approval': 'Integrity record only, not an external R03 anchor'})\n\nif __name__ == '__main__':\n    mode = sys.argv[1]\n    if mode == 'sources':\n        sources()\n    elif mode == 'red-p2':\n        sys.exit(v.run('before-fix-p2', [PY, '-B', '-m', 'unittest', *[\n            'backend.tests.v02.test_http.SQLiteHTTPTests.' + name for name in [\n                'test_p2_renderer_top_level_page_mutation_cannot_change_validated_release',\n                'test_p2_nested_page_and_context_mutations_preserve_data_and_next_http_request',\n                'test_p2_mutating_renderer_failure_is_safe_and_leaves_release_intact']], '-v']))\n    elif mode == 'p3':\n        sys.exit(v.run('p3-regressions', [PY, '-B', '-m', 'unittest',\n            'backend.tests.v02.test_unit.HelperEvidenceIntegrityTests', '-v']))\n    elif mode == 'v02':\n        sys.exit(v.run('v02-complete', [PY, '-B', '-m', 'unittest', 'backend.tests.v02.test_unit',\n            'backend.tests.v02.test_http', 'backend.tests.v02.test_postgres', 'backend.tests.v02.test_asset_regressions', '-v'],\n            {'MATHSTART_V02_TEST_ADMIN_URL': 'postgresql+psycopg://postgres:synthetic-local-only@127.0.0.1:15441/postgres'}))\n    elif mode == 'baseline':\n        sys.exit(v.run('baseline-driver', [PY, '-B', '-m', 'backend.tests.v02.baseline'],\n            {'MATHSTART_V02_TEST_ADMIN_URL': 'postgresql+psycopg://postgres:synthetic-local-only@127.0.0.1:15441/postgres'}))\n    elif mode == 'r02':\n        sys.exit(v.run('r02-contracts', [PY, '-B', '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_migration_r02_*.py', '-v']))\n    elif mode == 'full-content':\n        # Use the unchanged prior helper with only its output-receipt directory\n        # redirected in memory. Preserve its physical raw source hash.\n        source = (ROOT / 'var/i02_handoff_full_content.py').read_bytes().decode('utf-8')\n        source = source.replace('i02-handoff-followup-20261015', 'i02-handoff-p2-p3-20261015')\n        code = \"__file__=\" + repr(str(ROOT / 'var/i02_handoff_full_content.py')) + '\\n' + source\n        sys.exit(v.run('full-content-loader', [PY, '-B', '-c', code]))\n    elif mode == 'command':\n        sys.exit(v.run(sys.argv[2], sys.argv[3:]))\n",
