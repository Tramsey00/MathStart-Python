+      "source_utf8": "\"\"\"Retain scoped remediation evidence; never stage, publish or rewrite old records.\"\"\"\nimport ast\nimport base64\nfrom collections import Counter\nfrom datetime import datetime, timezone\nfrom hashlib import sha256\nimport importlib.metadata\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\n\nROOT = Path(__file__).resolve().parents[1]\nE = ROOT / 'docs/acceptance/MS7-MIG-V02/i02-handoff-p2-p3-20261015'\nINTAKE = json.loads((E / 'intake.json').read_bytes().decode('utf-8'))\nALLOWED = set(INTAKE['modified'])\nENV = {**os.environ, 'GIT_OPTIONAL_LOCKS': '0', 'PYTHONDONTWRITEBYTECODE': '1'}\nassert not (E / 'verification.json').exists(), 'Refuse to overwrite a final record'\n\ndef sha(raw):\n    return sha256(raw).hexdigest()\n\ndef b64(raw):\n    return base64.b64encode(raw).decode('ascii')\n\ndef save(name, value):\n    (E / name).write_bytes((json.dumps(value, ensure_ascii=True, indent=2) + '\\n').encode('utf-8'))\n\ndef git(*args, data=None):\n    return subprocess.check_output(['git', *args], cwd=ROOT, env=ENV, input=data)\n\ndef parse_tests(raw):\n    text = raw.decode('utf-8', errors='strict')\n    return [{'name': m[1], 'result': m[2]} for m in re.findall(\n        r'^(test_\\w+) \\(([\\w.]+)\\)(?:(?!^test_).)*?\\.\\.\\. (ok|FAIL|ERROR|skipped[^\\r\\n]*)',\n        text, re.MULTILINE | re.DOTALL)]\n\ndef preserve():\n    assert git('rev-parse', 'HEAD').decode().strip() == INTAKE['head']\n    assert git('branch', '--show-current').decode().strip() == INTAKE['branch']\n    assert git('rev-parse', 'HEAD^{tree}').decode().strip() == INTAKE['candidate_tree']\n    index = Path(git('rev-parse', '--git-path', 'index').decode().strip())\n    assert sha(index.read_bytes()) == INTAKE['index_sha256']\n    assert not git('diff', '--cached', '--name-only')\n    assert set(git('diff', '--name-only').decode().splitlines()) == ALLOWED\n    checked = []\n    for name, pin in INTAKE['snapshot_sha256'].items():\n        if name not in ALLOWED:\n            assert sha((ROOT / name).read_bytes()) == pin, name\n            checked.append(name)\n    for name, pin in INTAKE['helper_source_pins'].items():\n        assert sha((ROOT / name).read_bytes()) == pin, name\n    assert sha(Path(INTAKE['independent_audit_report_path']).read_bytes()) == INTAKE['independent_audit_report_sha256']\n    assert sha(base64.b64decode(INTAKE['independent_audit_report_base64'], validate=True)) == INTAKE['independent_audit_report_sha256']\n    new_paths = git('ls-files', '--others', '--exclude-standard').decode().splitlines()\n    assert set(INTAKE['untracked']) <= set(new_paths)\n    assert all(p in INTAKE['untracked'] or p.startswith(E.relative_to(ROOT).as_posix() + '/') for p in new_paths)\n    assert sha((ROOT / 'backend/content/releases.py').read_bytes()) == INTAKE['snapshot_sha256']['backend/content/releases.py']\n    return {'protected_files_checked': len(checked), 'other_tracked_files': len(checked) - len(INTAKE['untracked']),\n        'previous_evidence_files': len(INTAKE['untracked']), 'all_unchanged': True,\n        'original_helpers_unchanged': len(INTAKE['helper_source_pins']), 'independent_negative_audit_unchanged': True,\n        'raw_index_sha256': sha(index.read_bytes()), 'head_unchanged': True, 'index_unchanged': True,\n        'staged_changes': 0, 'tracked_modified': sorted(ALLOWED), 'home_context_production_unchanged_since_intake': True,\n        'boundaries': {'frozen_R02_R02A_R03A': 'UNCHANGED', 'V01_Alembic': 'UNCHANGED',\n            'frontend_Django_V04': 'UNCHANGED', 'root_CI_R03': 'UNCHANGED',\n            'historical_evidence_policy_manifests_approval_pins': 'UNCHANGED'}}\n\npreservation = preserve()\ncommands, receipts = [], {}\nfor path in sorted(E.glob('*.json')):\n    record = json.loads(path.read_bytes().decode('utf-8'))\n    if 'label' not in record:\n        continue\n    label = record['label']\n    assert label == path.stem\n    stdout = (E / (label + '.stdout.log')).read_bytes()\n    stderr = (E / (label + '.stderr.log')).read_bytes()\n    assert sha(stdout) == record['stdout_sha256'] and sha(stderr) == record['stderr_sha256']\n    named = parse_tests(stdout + b'\\n' + stderr)\n    record['named_tests'] = named\n    record['actual_counts'] = dict(Counter(t['result'] for t in named))\n    if label == 'before-fix-p2':\n        assert record['exit_code'] == 1 and record['test_count'] == 3\n        assert record['actual_counts'] == {'FAIL': 3}\n        record['classification'] = 'EXPECTED_FAIL: three HTTP regressions reproduce original mutable page defect'\n    elif label == 'after-fix-p2':\n        assert record['exit_code'] == 1 and b'IndentationError' in stderr\n        record['classification'] = 'RESOLVED task-introduced indentation error during patch authoring; no tests executed'\n    elif label == 'v02-final':\n        assert record['exit_code'] == 0 and len([t for t in named if t['result'].startswith('skipped')]) == 50\n        record['classification'] = 'INCOMPLETE_COVERAGE: additional run omitted PG URL; 68 PASS/50 SKIP, replaced by final explicit-PG run'\n    else:\n        assert record['exit_code'] == 0, record\n        record['classification'] = 'PASS'\n    record['raw_receipt_key'] = label\n    receipts[label] = {'stdout_base64': b64(stdout), 'stderr_base64': b64(stderr),\n        'stdout_sha256': sha(stdout), 'stderr_sha256': sha(stderr)}\n    commands.append(record)\n    save(path.name, record)\n\ndriver = next(r for r in receipts if r == 'baseline-driver')\nrows = [json.loads(line) for line in base64.b64decode(receipts[driver]['stdout_base64']).decode('utf-8').splitlines() if line.startswith('{')]\nruntime = Path(rows[0]['log']).parent\nbaseline = json.loads((runtime / 'results.json').read_bytes().decode('utf-8'))\nassert baseline['disposable'] and len(baseline['commands']) == 5\nfor label, result in zip(['fresh-install-smoke', 'verify-repo', 'baseline-version-report', 'r02a', 'r03a'], baseline['commands']):\n    raw = Path(result['log']).read_bytes()\n    assert result['exit_code'] == 0\n    counts = [int(n) for n in re.findall(rb'Ran (\\d+) tests? in', raw)]\n    if label == 'verify-repo':\n        assert b'RESULT: PASS (8 checks passed).' in raw\n        assert counts == [109, 18, 73], counts\n        assert not re.search(rb'OK \\(skipped=', raw)\n    if label in {'r02a', 'r03a'}:\n        assert counts == ([30] if label == 'r02a' else [41])\n    receipts[label] = {'combined_base64': b64(raw), 'combined_sha256': sha(raw)}\n    commands.append({'label': label, 'exit_code': result['exit_code'], 'argv': result['argv'],\n        'suite_test_counts': counts, 'named_tests': parse_tests(raw), 'raw_receipt_key': label,\n        'classification': 'PASS', 'source_log': result['log'], 'combined_sha256': sha(raw)})\n\nfinal_suites = {'v02-final-with-pg': 118, 'v01-complete': 34, 'r02-contracts': 63, 'r02a': 30, 'r03a': 41}\nmatrix = []\nfor label, count in final_suites.items():\n    record = next(r for r in commands if r['label'] == label)\n    assert len(record['named_tests']) == count, (label, len(record['named_tests']))\n    assert all(t['result'] == 'ok' for t in record['named_tests']), label\n    matrix.extend({'suite': label, **t} for t in record['named_tests'])\npg = [t for t in matrix if t['suite'] == 'v02-final-with-pg' and 'PostgreSQL' in t['name']]\nassert len(pg) == 50, len(pg)\nprior_methods = set(re.findall(rb'^\\+    def (test_\\w+)\\(', base64.b64decode(INTAKE['prior_diff_base64']), re.MULTILINE))\ndef methods(raw):\n    return {item.name.encode() for node in ast.parse(raw).body if isinstance(node, ast.ClassDef)\n        for item in node.body if isinstance(item, ast.FunctionDef) and item.name.startswith('test_')}\nall_added = set()\nfor name in ['backend/tests/v02/test_unit.py', 'backend/tests/v02/test_http.py']:\n    all_added |= methods((ROOT / name).read_bytes()) - methods(git('show', INTAKE['head'] + ':' + name))\nremediation_methods = all_added - prior_methods\nassert len(remediation_methods) == 7\nnew_executions = [t for t in matrix if t['suite'] == 'v02-final-with-pg' and t['name'].split('.')[-1].encode() in remediation_methods]\nassert len(new_executions) == 10\nsave('test-inventory.json', {'final_suites': final_suites, 'v02_postgresql': len(pg), 'final_suite_failures': 0,\n    'final_suite_skips': 0, 'p2_p3_new_methods': sorted(n.decode() for n in remediation_methods),\n    'p2_p3_executions': new_executions, 'all_named_target_and_contract_tests': matrix,\n    'verify_repo_checks': 8, 'verify_repo_nested_counts': [109, 18, 73], 'verify_repo_skips': 0,\n    'intermediate_attempts': 'See verification/raw receipts: expected red3, resolved syntax error, omitted-PG run68PASS/50SKIP are retained'})\n\nfull = json.loads(base64.b64decode(receipts['full-content-loader']['stdout_base64']).decode('utf-8').splitlines()[-1])\nassert full['pages'] == 279 and full['topics'] == 263 and full['full_profile_loader'] == 'PASS'\nsmoke = json.loads(base64.b64decode(receipts['runtime-no-django']['stdout_base64']).decode('utf-8'))\nassert len(smoke['http_smoke']) == 8 and not smoke['django_installed'] and not smoke['django_imported']\n\n# Old helpers and old raw evidence stay untouched. Archive only new tooling here.\ntool_sources = {}\nfor name in ['var/i02_p2_p3_intake.py', 'var/i02_p2_p3_verify.py', 'var/i02_p2_p3_finalize.py']:\n    raw = (ROOT / name).read_bytes()\n    text = raw.decode('utf-8', errors='strict')\n    assert text.encode('utf-8') == raw\n    tool_sources[name] = {'source_encoding': 'utf-8', 'raw_bytes_base64': b64(raw), 'raw_sha256': sha(raw),\n        'raw_size': len(raw), 'source_utf8': text, 'source_utf8_sha256': sha(text.encode('utf-8'))}\nsave('reproduction-tools.json', {'sources': tool_sources, 'normalization': 'NONE',\n    'note': 'Historical five helper sources are separately retained in helper-sources-v2.json with unchanged intake pins'})\nsave('raw-command-receipts.json', {'encoding': 'Exact raw stdout/stderr or combined bytes as base64; NO normalization',\n    'receipts': receipts, 'baseline_results': baseline})\nfor label, receipt in receipts.items():\n    for suffix, key in [('.stdout.log', 'stdout_base64'), ('.stderr.log', 'stderr_base64')]:\n        path = E / (label + suffix)\n        if path.exists():\n            assert path.parent.resolve() == E.resolve()\n            assert path.read_bytes() == base64.b64decode(receipt[key], validate=True)\n            path.unlink()\n\nfiles = {}\nfor name in sorted(ALLOWED):\n    raw = (ROOT / name).read_bytes()\n    cleaned = raw.replace(b'\\r\\n', b'\\n')\n    oid = git('hash-object', '--path=' + name, '--stdin', data=raw).decode().strip()\n    from hashlib import sha1\n    assert sha1(b'blob ' + str(len(cleaned)).encode() + b'\\0' + cleaned).hexdigest() == oid\n    files[name] = {'intake_working_sha256': INTAKE['snapshot_sha256'][name], 'working_sha256': sha(raw),\n        'working_size': len(raw), 'prospective_blob_sha256': sha(cleaned), 'prospective_blob_oid': oid,\n        'mode': git('ls-files', '--stage', '--', name).decode().split()[0], 'staged': False,\n        'attributes': git('check-attr', '-a', '--', name).decode().splitlines(),\n        'baseline_blob_oid': git('rev-parse', INTAKE['head'] + ':' + name).decode().strip()}\nsave('changed-bytes.json', {'files': files, 'object_write_or_index_update': False,\n    'remediation_changed_since_intake': [name for name, r in files.items() if r['intake_working_sha256'] != r['working_sha256']],\n    'note': 'Read-only prospective clean-filter OID; working bytes have their own separate digests'})\ndiff = git('diff', '--binary', '--no-ext-diff', '--', *sorted(ALLOWED))\nsave('source-diff.json', {'parent_candidate_sha': INTAKE['head'], 'diff_sha256': sha(diff), 'diff_base64': b64(diff),\n    'numstat': git('diff', '--numstat').decode(), 'prior_diff_sha256': INTAKE['prior_diff_sha256']})\nwhitespace = []\nfor label, args in [('worktree-ordinary', ['diff', '--check']),\n    ('worktree-cr-at-eol', ['-c', 'core.whitespace=cr-at-eol', 'diff', '--check']),\n    ('cached-ordinary', ['diff', '--cached', '--check']),\n    ('cached-cr-at-eol', ['-c', 'core.whitespace=cr-at-eol', 'diff', '--cached', '--check'])]:\n    p = subprocess.run(['git', *args], cwd=ROOT, env=ENV, capture_output=True)\n    assert p.returncode == 0 and not p.stdout and not p.stderr\n    whitespace.append({'label': label, 'argv': ['git', *args], 'exit_code': p.returncode,\n        'stdout_base64': b64(p.stdout), 'stderr_base64': b64(p.stderr)})\nsave('whitespace.json', {'checks': whitespace, 'scope': 'Current follow-up diff against HEAD; original publication FAIL/2 and approved40path policy are preserved history'})\nsave('preservation.json', preserve())\nversions = {'python': sys.version, 'executable': sys.executable,\n    'packages': {name: importlib.metadata.version(name) for name in ['Django', 'fastapi', 'starlette', 'SQLAlchemy', 'psycopg', 'alembic', 'jsonschema']},\n    **{label: base64.b64decode(receipts[label]['stdout_base64']).decode('utf-8').strip()\n       for label in ['docker-version', 'linux-python-version', 'postgres-version']}}\nrecord = {'recommendation': 'READY FOR INDEPENDENT RE-AUDIT', 'recorded_utc': datetime.now(timezone.utc).isoformat(),\n    'parent_candidate_sha': INTAKE['head'], 'tested_implementation_sha': None, 'HEAD': 'unchanged',\n    'commit_push_merge_rebase_PR_update': 'NOT PERFORMED', 'P2_mutable_page': 'LOCALLY_FIXED', 'P3_source_utf8': 'LOCALLY_FIXED',\n    'independent_audit_original_verdict': 'CHANGES REQUIRED; preserved, not superseded by local approval',\n    'P3_reconciliation': 'Both original source_utf8 values match declared raw SHA when JSON is decoded UTF-8. Both reported mismatch hashes reproduce exactly through CP1251 misread. Actual auditor command responsible is unproven. Explicit encoding/raw-byte verification added without changing old bytes/pins.',\n    'tests': {'V02': '118 PASS / 0 FAIL / 0 SKIP', 'V02