+      "source_utf8": "\"\"\"Retain new follow-up receipts without rewriting any candidate manifest/pin.\"\"\"\nimport ast\nimport base64\nfrom collections import Counter\nfrom datetime import datetime, timezone\nfrom hashlib import sha256\nimport importlib.metadata\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'var'))\nimport i02_handoff_verify as v\nE = v.E\nINITIAL = json.loads((E / 'source-baseline.json').read_bytes())\nassert not (E / 'verification.json').exists(), 'Final evidence already exists: refuse overwrite'\n\ndef sha(raw):\n    return sha256(raw).hexdigest()\n\ndef save(path, data):\n    v.save(path, data)\n\ndef git(*argv, data=None):\n    return subprocess.check_output(['git', *argv], cwd=ROOT, env=v.ENV, input=data)\n\nassert git('rev-parse', 'HEAD').decode().strip() == v.HEAD\nassert git('branch', '--show-current').decode().strip() == 'ms7-mig-v02-content'\nassert git('rev-parse', 'HEAD^{tree}').decode().strip() == INITIAL['initial_tree_oid']\nindex_path = Path(git('rev-parse', '--git-path', 'index').decode().strip())\nassert sha(index_path.read_bytes()) == INITIAL['raw_index_sha256']\nassert not git('diff', '--cached', '--name-only')\nchanged = set(git('diff', '--name-only').decode().splitlines())\nassert changed == v.ALLOWED, changed\nfor path, pin in INITIAL['protected_working_hashes'].items():\n    assert sha((ROOT / path).read_bytes()) == pin, 'Protected source drift: ' + path\nnew_paths = git('ls-files', '--others', '--exclude-standard').decode().splitlines()\nassert all(p.startswith(E.relative_to(ROOT).as_posix() + '/') for p in new_paths), new_paths\n\nraw_receipts = {}\ncommands = []\nfor receipt_path in sorted(E.glob('*.json')):\n    record = json.loads(receipt_path.read_bytes())\n    if 'label' not in record:\n        continue\n    label = receipt_path.stem\n    if label == 'before-fix-home':\n        assert record['exit_code'] == 1 and record['test_count'] == 2\n        record['classification'] = 'EXPECTED_FAIL: old production loader; seven assertion/subtest failures across two regressions'\n    elif label == 'runtime-no-django-initial-harness-error':\n        assert record['exit_code'] == 1\n        record['classification'] = 'RESOLVED verification helper import path, before runtime startup; not a product failure'\n    elif label == 'runtime-environment-pip':\n        assert record['exit_code'] == 1\n        record['classification'] = 'Runtime venv intentionally has no pip module; dependency check subsequently PASS using pip --python'\n    else:\n        assert record['exit_code'] == 0, record\n        record['classification'] = 'PASS'\n    stdout = (E / (label + '.stdout.log')).read_bytes()\n    stderr = (E / (label + '.stderr.log')).read_bytes()\n    assert sha(stdout) == record['stdout_sha256'] and sha(stderr) == record['stderr_sha256']\n    raw_receipts[label] = {'stdout_base64': base64.b64encode(stdout).decode(),\n                           'stderr_base64': base64.b64encode(stderr).decode(),\n                           'stdout_sha256': sha(stdout), 'stderr_sha256': sha(stderr)}\n    record['raw_receipt_key'] = label\n    commands.append(record)\n    save(receipt_path, record)\n\ndriver = [json.loads(line) for line in base64.b64decode(raw_receipts['baseline-driver']['stdout_base64']).decode().splitlines() if line.startswith('{')]\nbaseline_root = Path(driver[0]['log']).parent\nbaseline_record = json.loads((baseline_root / 'results.json').read_bytes())\nassert baseline_record['disposable'] and len(baseline_record['commands']) == 5\nfor label, record in zip(['fresh-install-smoke', 'verify-repo', 'baseline-version-report', 'r02a', 'r03a'], baseline_record['commands']):\n    raw = Path(record['log']).read_bytes()\n    assert record['exit_code'] == 0\n    text = raw.decode('utf-8', errors='replace')\n    counts = [int(x) for x in re.findall(r'Ran (\\d+) tests? in', text)]\n    if label == 'verify-repo':\n        assert 'RESULT: PASS (8 checks passed).' in text\n    if label == 'r02a':\n        assert counts == [30]\n    if label == 'r03a':\n        assert counts == [41]\n    raw_receipts[label] = {'combined_base64': base64.b64encode(raw).decode(), 'combined_sha256': sha(raw)}\n    named = [{'name': m[1], 'result': m[2]} for m in re.findall(\n        r'^(test_\\w+) \\(([\\w.]+)\\)(?:(?!^test_).)*?\\.\\.\\. (ok|FAIL|ERROR|skipped[^\\r\\n]*)',\n        text, re.MULTILINE | re.DOTALL)]\n    commands.append({'label': label, 'argv': record['argv'], 'exit_code': 0, 'classification': 'PASS',\n        'suite_test_counts': counts, 'named_tests': named, 'source_log': record['log'],\n        'combined_sha256': sha(raw), 'raw_receipt_key': label})\n\nmatrix = []\nfor record in commands:\n    if record['label'] in {'v02-complete', 'v01-complete', 'r02-contracts', 'r02a', 'r03a'}:\n        for test in record.get('named_tests', []):\n            assert test['result'] == 'ok', test\n            matrix.append({'suite': record['label'], **test})\ncounts = Counter(item['suite'] for item in matrix)\nassert counts == {'v02-complete': 108, 'v01-complete': 34, 'r02-contracts': 63, 'r02a': 30, 'r03a': 41}, counts\nnew_method_names = set()\nfor path in ['backend/tests/v02/test_unit.py', 'backend/tests/v02/test_http.py']:\n    def methods(raw):\n        tree = ast.parse(raw)\n        return {item.name for node in tree.body if isinstance(node, ast.ClassDef)\n                for item in node.body if isinstance(item, ast.FunctionDef) and item.name.startswith('test_')}\n    new_method_names |= methods((ROOT / path).read_bytes()) - methods(git('show', v.HEAD + ':' + path))\nnew_executions = [r for r in matrix if r['suite'] == 'v02-complete' and r['name'].split('.')[-1] in new_method_names]\nassert len(new_method_names) == 15 and len(new_executions) == 22\nsave(E / 'test-inventory.json', {'counts': counts, 'new_test_methods': sorted(new_method_names),\n    'new_test_executions': new_executions, 'all_named_contract_and_target_tests': matrix,\n    'v02_postgresql_tests': sum('PostgreSQL' in r['name'] for r in matrix if r['suite'] == 'v02-complete'),\n    'skips_in_named_suites': 0, 'verify_repo_nested_counts': [109, 18, 73], 'verify_repo_checks': 8})\n\ndiff = git('diff', '--binary', '--no-ext-diff', '--', *sorted(v.ALLOWED))\nsave(E / 'source-diff.json', {'parent_candidate_sha': v.HEAD, 'git_diff_sha256': sha(diff),\n    'git_diff_base64': base64.b64encode(diff).decode(), 'numstat': git('diff', '--numstat').decode(),\n    'encoding': 'Base64 preserves exact patch bytes; it is not a historical patch rewrite'})\nfiles = {}\nfor path in sorted(v.ALLOWED):\n    raw = (ROOT / path).read_bytes()\n    canonical = raw.replace(b'\\r\\n', b'\\n')\n    oid = git('hash-object', '--path=' + path, '--stdin', data=raw).decode().strip()\n    attr = git('check-attr', '-a', '--', path).decode().splitlines()\n    files[path] = {**INITIAL['allowed_baseline'][path], 'working_sha256': sha(raw), 'working_bytes': len(raw),\n                  'reviewed_blob_sha256': sha(canonical), 'prospective_blob_oid': oid,\n                  'effective_attributes_all': attr, 'mode': '100644', 'staged': False}\nsave(E / 'changed-bytes.json', {'parent_candidate_sha': v.HEAD, 'files': files,\n    'note': 'Prospective OIDs were calculated read-only; no Git index update or object write'})\n\nwhitespace = []\nfor name, argv in [('worktree-ordinary', ['diff', '--check']),\n                   ('worktree-cr-at-eol', ['-c', 'core.whitespace=cr-at-eol', 'diff', '--check']),\n                   ('cached-ordinary', ['diff', '--cached', '--check']),\n                   ('cached-cr-at-eol', ['-c', 'core.whitespace=cr-at-eol', 'diff', '--cached', '--check'])]:\n    p = subprocess.run(['git', *argv], cwd=ROOT, env=v.ENV, capture_output=True)\n    assert p.returncode == 0 and not p.stdout and not p.stderr\n    whitespace.append({'name': name, 'argv': ['git', *argv], 'exit_code': p.return