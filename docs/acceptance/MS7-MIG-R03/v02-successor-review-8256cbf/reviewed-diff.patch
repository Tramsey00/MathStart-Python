+      "source_utf8": "\"\"\"Recheck the new loader against the new disposable 279/263 source baseline.\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport uuid\nfrom hashlib import sha256\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n\nROOT = Path.cwd()\nE = ROOT / 'docs/acceptance/MS7-MIG-V02/i02-handoff-followup-20261015'\ndriver = [json.loads(line) for line in (E / 'baseline-driver.stdout.log').read_text(encoding='utf-8').splitlines() if line.startswith('{')]\nruntime = Path(driver[0]['log']).parent\nrecord = json.loads((runtime / 'results.json').read_text(encoding='utf-8'))\nassert record['disposable'] and record['database'].startswith('ms6_v01_smoke_v02_')\nassert all(r['exit_code'] == 0 for r in record['commands'])\nos.environ.update(DJANGO_DB_BACKEND='postgresql', DJANGO_DB_HOST='127.0.0.1', DJANGO_DB_PORT='15441',\n    DJANGO_DB_NAME=record['database'], DJANGO_DB_USER='postgres', DJANGO_DB_PASSWORD='synthetic-local-only',\n    DJANGO_SECRET_KEY='synthetic-i02-followup-baseline', DJANGO_DEBUG='0', DJANGO_RUNTIME_ROOT=str(runtime))\noriginal = subprocess.run([sys.executable, '-B', '-m', 'backend.tests.v02.public_baseline_projection'], capture_output=True)\nassert original.returncode == 0, original.stderr.decode(errors='replace')[-2000:]\nprint(original.stdout.decode(), flush=True)\nimport sqlalchemy as sa\nfrom sqlalchemy.engine import URL\nfrom backend.content.projection import ReviewedSource, delivery_candidate, build_index_candidate\nfrom backend.content.releases import Descriptor, ReleaseStore\nfrom backend.infrastructure.database import DatabaseConfig, create_engine\nfrom backend.infrastructure.uow import UnitOfWork\nfrom backend.models.baseline import ContentPage, LessonPublication\nengine = create_engine(DatabaseConfig(URL.create('postgresql+psycopg', username='postgres',\n    password='synthetic-local-only', host='127.0.0.1', port=15441, database=record['database'])))\nrelease_id = 'i02-loader-' + uuid.uuid4().hex\nroot = ROOT / 'var' / release_id\npages_root = root / release_id / 'pages'\npages_root.mkdir(parents=True)\nsql = []\nsa.event.listen(engine, 'before_cursor_execute', lambda c, cu, statement, p, ctx, m: sql.append(statement))\nwith UnitOfWork(engine) as uow:\n    uow.session.execute(sa.text('SET TRANSACTION READ ONLY'))\n    pages = list(uow.session.scalars(sa.select(ContentPage).where(ContentPage.is_published.is_(True)).order_by(ContentPage.id)))\n    deliveries = {}\n    for page in pages:\n        source = uow.session.scalar(sa.select(LessonPublication.source_path).where(LessonPublication.page_id == page.id))\n        source = 'curriculum/' + source if source else f'site_content/pages/{page.slug}/page.json'\n        path = (ROOT / source).resolve()\n        assert path.is_relative_to(ROOT)\n        if path.is_dir():\n            source += '/lesson.json'\n            path /= 'lesson.json'\n        data = delivery_candidate(uow, page.slug, ReviewedSource(source, sha256(path.read_bytes()).hexdigest(), ()))\n        deliveries[page.id] = data\n        (pages_root / f'{page.id}.json').write_text(json.dumps(data, ensure_ascii=False), encoding='utf-8')\n    index = build_index_candidate(uow, release_id, deliveries)\nraw = json.dumps(index, ensure_ascii=False).encode('utf-8')\n(root / release_id / 'index.json').write_bytes(raw)\ndescriptor = Descriptor(uuid.uuid4(), release_id, sha256(raw).hexdigest(), 1)\nrelease = ReleaseStore(root).load(descriptor)\nassert len(release.pages) == 279 and len(release.index['catalogue']['topics']) == 263\ncontext = release.renderer_context(release.page('karta-sajta'), {'q': 'НЕСУЩЕСТВУЮЩАЯ ТЕМА'})\nassert context['catalogue_full'] == index['catalogue']\nassert context['pinned_release'] == {'release_id': release_id, 'manifest_digest': descriptor.manifest_digest}\nassert context['catalogue_count'] == 0\nassert all(q.lstrip().upper().startswith(('SELECT', 'SET TRANSACTION READ ONLY')) for q in sql)\nprint(json.dumps({'full_profile_loader': 'PASS', 'pages': 279, 'topics': 263,\n    'home_alias': release.page_path('/glavnaya/')['seo']['canonical_path'],\n    'catalogue_full_and_identity': 'PASS', 'empty_search_count': 0, 'read_only_sql': 'PASS',\n    'assets_scope': 'Metadata/loader profile uses empty reviewed asset arrays; full asset regressions are in V02 suite',\n    'activation': 'NOT_PERFORMED', 'i02_html_no_js': 'NOT_VERIFIED'}))\nengine.dispose()\n"
