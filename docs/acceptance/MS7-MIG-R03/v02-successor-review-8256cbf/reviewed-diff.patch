+{
+  "source_encoding": "utf-8",
+  "raw_bytes_base64": "",
+  "raw_sha256": "4404fef88e9580da93df28cf14e6a6fa50d7eba5eb3041c922c72f03d4f5c6ce",
+  "raw_size": 8346,
+  "source_utf8": "\"\"\"Independent reread of local evidence bytes; integrity only, never human approval.\"\"\"\nimport base64\nfrom hashlib import sha256\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\n\nROOT = Path(__file__).resolve().parents[1]\nE = ROOT / 'docs/acceptance/MS7-MIG-V02/i02-handoff-p2-p3-20261015'\nENV = {**os.environ, 'GIT_OPTIONAL_LOCKS': '0', 'PYTHONDONTWRITEBYTECODE': '1'}\n\ndef sha(raw):\n    return sha256(raw).hexdigest()\n\ndef save(name, value):\n    (E / name).write_bytes((json.dumps(value, ensure_ascii=True, indent=2) + '\\n').encode('utf-8'))\n\ndef read(name):\n    return json.loads((E / name).read_bytes().decode('utf-8', errors='strict'))\n\nassert not (E / 'evidence-inventory.json').exists(), 'Refuse overwrite of completed evidence inventory'\nintake = read('intake.json')\nraw_receipts = read('raw-command-receipts.json')['receipts']\nchecked_receipts = 0\nfor label, record in raw_receipts.items():\n    for key, value in record.items():\n        if key.endswith('_base64'):\n            raw = base64.b64decode(value, validate=True)\n            assert sha(raw) == record[key.removesuffix('_base64') + '_sha256']\n            checked_receipts += 1\n\nspec = importlib.util.spec_from_file_location('new_helper_guard', E / 'verify_helper_sources.py')\nguard = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(guard)\noriginal_guard = guard.verify(read('helper-sources-v2.json'), intake['helper_source_pins'], ROOT)\nhelper_reads = 0\nfor bundle in [read('helper-sources-v2.json'), read('reproduction-tools.json')]:\n    for name, record in bundle['sources'].items():\n        raw = base64.b64decode(record['raw_bytes_base64'], validate=True)\n        assert record['source_encoding'] == 'utf-8'\n        assert sha(raw) == record['raw_sha256'] and len(raw) == record['raw_size']\n        assert record['source_utf8'].encode('utf-8') == raw\n        assert sha(record['source_utf8'].encode('utf-8')) == record['source_utf8_sha256']\n        assert (ROOT / name).read_bytes() == raw and (ROOT / name).read_bytes() == raw\n        helper_reads += 2\nseal_raw = Path(__file__).read_bytes()\nsave('evidence-verifier-source.json', {'source_encoding': 'utf-8', 'raw_bytes_base64': base64.b64encode(seal_raw).decode('ascii'),\n    'raw_sha256': sha(seal_raw), 'raw_size': len(seal_raw), 'source_utf8': seal_raw.decode('utf-8'),\n    'source_utf8_sha256': sha(seal_raw), 'scope': 'This local evidence integrity verifier is not independent human review or an R03 approval'})\n\npaths = [p for p in sorted(E.iterdir()) if p.is_file()]\nallowed = intake['modified']\npatterns = {'private_key': rb'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----',\n    'github_token': rb'\\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{50,})\\b',\n    'aws_key': rb'\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b',\n    'openai_key': rb'\\bsk-(?:proj-)?[A-Za-z0-9_-]{40,}\\b'}\ninputs = [(str(p.relative_to(ROOT)), p.read_bytes()) for p in paths]\ninputs += [(name, (ROOT / name).read_bytes()) for name in allowed]\nfor label, receipt in raw_receipts.items():\n    for key, value in receipt.items():\n        if key.endswith('_base64'):\n            inputs.append((label + ':' + key, base64.b64decode(value, validate=True)))\ninputs += [('current-diff', base64.b64decode(read('source-diff.json')['diff_base64'], validate=True)),\n    ('prior-diff', base64.b64decode(intake['prior_diff_base64'], validate=True)),\n    ('negative-independent-audit', base64.b64decode(intake['independent_audit_report_base64'], validate=True))]\nfor bundle in [read('helper-sources-v2.json'), read('reproduction-tools.json')]:\n    inputs += [(name, base64.b64decode(rec['raw_bytes_base64'], validate=True)) for name, rec in bundle['sources'].items()]\nhits = [{'path': path, 'signature': name} for path, raw in inputs for name, pattern in patterns.items() if re.search(pattern, raw)]\nassert not hits, hits\nsave('secrets-scan.json', {'known_signature_hits': hits, 'scanned_inputs': len(inputs),\n    'scope': 'Five scoped sources; all new evidence at scan time; decoded command bytes, helper sources, prior/current diffs and preserved negative audit',\n    'test_credentials': 'Only documented synthetic fixture credentials in captured commands; no live provider or production credentials introduced',\n    'limit': 'Known-signature scan and scoped diff review; not a universal proof about arbitrary unknown secret formats'})\n\nprotected = 0\nfor name, pin in intake['snapshot_sha256'].items():\n    if name not in allowed:\n        assert sha((ROOT / name).read_bytes()) == pin, name\n        protected += 1\nassert protected == 1845\nassert sha(Path(intake['independent_audit_report_path']).read_bytes()) == intake['independent_audit_report_sha256']\ngit = lambda *a: subprocess.check_output(['git', *a], cwd=ROOT, env=ENV)\nindex_path = Path(git('rev-parse', '--git-path', 'index').decode().strip())\nassert sha(index_path.read_bytes()) == intake['index_sha256']\nassert git('rev-parse', 'HEAD').decode().strip() == intake['head']\nassert git('branch', '--show-current').decode().strip() == intake['branch']\nassert set(git('diff', '--name-only').decode().splitlines()) == set(allowed)\nassert not git('diff', '--cached', '--name-only')\nfor name, record in read('changed-bytes.json')['files'].items():\n    assert sha((ROOT / name).read_bytes()) == record['working_sha256']\n\nchecks = []\nfor p in sorted(E.iterdir()):\n    if not p.is_file():\n        continue\n    raw = p.read_bytes()\n    raw.decode('utf-8', errors='strict')\n    assert not raw.startswith(b'\\xef\\xbb\\xbf') and b'\\r' not in raw, p.name\n    result = subprocess.run(['git', 'diff', '--no-index', '--check', '--', '/dev/null', str(p)],\n        cwd=ROOT, env=ENV, capture_output=True)\n    assert result.returncode == 1 and not result.stdout and not result.stderr, (p.name, result.returncode, result.stdout, result.stderr)\n    checks.append({'path': p.relative_to(ROOT).as_posix(), 'exit_code': result.returncode,\n        'stdout_base64': '', 'stderr_base64': '', 'interpretation': 'New-file difference1, zero whitespace diagnostics; not PASS/0'})\nsave('new-records-whitespace.json', {'checks': checks, 'diagnostics': 0,\n    'scope': 'All new files existing before this whitespace receipt and inventory; these two generated records are checked on final reread'})\nsave('evidence-inventory.json', {'self_excluded': 'evidence-inventory.json', 'approval': 'NONE; local byte inventory only',\n    'checks': {'raw_streams_rehashed': checked_receipts, 'helper_physical_reads': helper_reads,\n        'standalone_original_guard': original_guard, 'protected_files_unchanged': protected, 'source_index_unchanged': True},\n    'files': [{'path': p.relative_to(ROOT).as_posix(), 'size': p.stat().st_size, 'sha256': sha(p.read_bytes())}\n        for p in sorted(E.iterdir()) if p.is_file() and p.name != 'evidence-inventory.json']})\ninventory = read('evidence-inventory.json')\nexpected = {r['path'] for r in inventory['files']}\nactual = {p.relative_to(ROOT).as_posix() for p in E.iterdir() if p.is_file() and p.name != 'evidence-inventory.json'}\nassert expected == actual\nfor record in inventory['files']:\n    first, second = (ROOT / record['path']).read_bytes(), (ROOT / record['path']).read_bytes()\n    assert sha(first) == sha(second) == record['sha256'] and len(first) == record['size']\nfor name in ['new-records-whitespace.json', 'evidence-inventory.json']:\n    p = E / name\n    result = subprocess.run(['git', 'diff', '--no-index', '--check', '--', '/dev/null', str(p)], cwd=ROOT, env=ENV, capture_output=True)\n    assert result.returncode == 1 and not result.stdout and not result.stderr\n    print(json.dumps({'file': name, 'whitespace_exit': result.returncode, 'diagnostics': 0}))\nuntracked = git('ls-files', '--others', '--exclude-standard').decode().splitlines()\nassert all(p in intake['untracked'] or p.startswith(E.relative_to(ROOT).as_posix() + '/') for p in untracked)\nassert len(untracked) == 27 + len(actual) + 1\nassert sha(index_path.read_bytes()) == intake['index_sha256']\nprint(json.dumps({'result': 'LOCAL_EVIDENCE_INTEGRITY_PASS', 'independent_review': 'PENDING',\n    'new_files': len(actual) + 1, 'total_untracked': len(untracked), 'modified_tracked': len(allowed),\n    'index_unchanged': True, 'head_unchanged': True, 'raw_streams_rehashed': checked_receipts,\n    'inventory_sha256': sha((E / 'evidence-inventory.json').read_bytes())}))\n",
+  "source_utf8_sha256": "4404fef88e9580da93df28cf14e6a6fa50d7eba5eb3041c922c72f03d4f5c6ce",
+  "scope": "This local evidence integrity verifier is not independent human review or an R03 approval"
